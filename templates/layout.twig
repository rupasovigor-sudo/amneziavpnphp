<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#5b53d6">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <script nonce="{{ csp_nonce }}">
        window.AMNEZIA_CSRF_TOKEN = {{ csrf_token|json_encode|raw }};
        (() => {
            const token = window.AMNEZIA_CSRF_TOKEN;
            const originalFetch = window.fetch;
            window.fetch = (input, init = {}) => {
                const requestUrl = input instanceof Request ? input.url : input;
                const url = new URL(requestUrl, window.location.href);
                const method = (init.method || (input instanceof Request ? input.method : 'GET')).toUpperCase();
                if (url.origin === window.location.origin && method !== 'GET' && method !== 'HEAD' && method !== 'OPTIONS') {
                    const headers = new Headers(init.headers || (input instanceof Request ? input.headers : undefined));
                    headers.set('X-CSRF-Token', token);
                    init = { ...init, headers };
                }
                return originalFetch(input, init);
            };

            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('form[method]').forEach((form) => {
                    if ((form.getAttribute('method') || '').toUpperCase() !== 'POST') {
                        return;
                    }
                    if (form.querySelector('input[name="_csrf_token"]')) {
                        return;
                    }
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = '_csrf_token';
                    input.value = token;
                    form.appendChild(input);
                });
            });
        })();
    </script>
    <!-- Compiled, self-hosted Tailwind (built via scripts/build_css.sh) — no
         Play CDN, so no unsafe-eval, faster loads, works offline. -->
    <!-- Apply saved/system theme before paint to avoid a flash. -->
    <script nonce="{{ csp_nonce }}">
        (function(){try{var t=localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.classList.add('dark');}}catch(e){}})();
    </script>
    <link rel="stylesheet" href="/assets/app.css">
    <!-- Self-hosted FontAwesome (no external cdnjs → CSP can drop it). -->
    <link rel="stylesheet" href="/assets/fa/css/all.min.css">
    <script src="/assets/chart.umd.min.js"></script>
    {% block styles %}{% endblock %}
</head>
<body class="bg-gray-50">
    {% if user %}
    {% set uri = current_uri|default('') %}
    {% set is_admin = user.role == 'admin' %}

    <!-- Mobile drawer backdrop -->
    <div id="sidebarBackdrop" class="fixed inset-0 bg-black/40 z-30 hidden lg:hidden" data-action="toggleSidebar"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar-drawer gradient-bg fixed inset-y-0 left-0 z-40 w-64 flex flex-col -translate-x-full lg:translate-x-0">
        <div class="h-16 flex items-center gap-2 px-4 border-b border-white/10 flex-shrink-0">
            <i class="fas fa-shield-alt text-white text-2xl"></i>
            <span class="text-white text-lg font-bold">{{ app_name }}</span>
        </div>
        <nav class="flex-1 overflow-y-auto px-3 py-3 space-y-0.5">
            <a href="/dashboard" class="nav-item {{ uri starts with '/dashboard' ? 'active' }}">
                <i class="fas fa-tachometer-alt w-5 text-center"></i><span>{{ t('menu.dashboard') }}</span>
            </a>
            <a href="/servers" class="nav-item {{ uri starts with '/servers' or uri starts with '/clients' ? 'active' }}">
                <i class="fas fa-server w-5 text-center"></i><span>{{ t('menu.servers') }}</span>
            </a>
            {% if is_admin %}
            <a href="/pools" class="nav-item {{ uri starts with '/pools' ? 'active' }}">
                <i class="fas fa-layer-group w-5 text-center"></i><span>Пулы</span>
            </a>
            <a href="/updates" class="nav-item {{ uri starts with '/updates' ? 'active' }}">
                <i class="fas fa-box w-5 text-center"></i><span>Обновления</span>
            </a>
            <div class="nav-group-label">Администрирование</div>
            <a href="/settings" class="nav-item {{ uri starts with '/settings' ? 'active' }}">
                <i class="fas fa-cog w-5 text-center"></i><span>{{ t('menu.settings') }}</span>
            </a>
            <a href="/backups" class="nav-item {{ uri starts with '/backups' ? 'active' }}">
                <i class="fas fa-database w-5 text-center"></i><span>Бэкапы</span>
            </a>
            <a href="/audit" class="nav-item {{ uri starts with '/audit' ? 'active' }}">
                <i class="fas fa-clipboard-list w-5 text-center"></i><span>Журнал</span>
            </a>
            {% endif %}
        </nav>
        <div class="border-t border-white/10 p-3 flex-shrink-0">
            <div class="text-indigo-100 text-sm px-2 mb-2 truncate"><i class="fas fa-user mr-2"></i>{{ user.name }}</div>
            <form method="POST" action="/logout">
                <button type="submit" class="nav-item w-full"><i class="fas fa-sign-out-alt w-5 text-center"></i><span>{{ t('menu.logout') }}</span></button>
            </form>
        </div>
    </aside>

    <!-- Content column (offset for the fixed sidebar on lg+) -->
    <div class="lg:pl-64 flex flex-col min-h-screen">
        <!-- Topbar -->
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 sm:px-6 sticky top-0 z-20">
            <button type="button" data-action="toggleSidebar" class="lg:hidden text-gray-600 hover:text-gray-900 -ml-1 p-2" aria-label="Меню">
                <i class="fas fa-bars text-xl"></i>
            </button>
            <div class="flex-1"></div>
            <!-- Theme toggle -->
            <button data-action="toggleTheme" class="text-gray-600 hover:text-gray-900 p-2 mr-1" aria-label="Тема" title="Светлая/тёмная тема">
                <i class="fas fa-moon dark:hidden"></i><i class="fas fa-sun hidden dark:inline"></i>
            </button>
            <!-- Language Selector -->
            <div class="relative">
                <button data-action="toggleLanguageDropdown" class="text-gray-600 hover:text-gray-900 flex items-center focus:outline-none">
                    {% for lang in languages %}{% if lang.code == current_language %}<span class="mr-1">{{ getFlag(lang.code) }}</span>{% endif %}{% endfor %}
                    <i class="fas fa-chevron-down ml-1 text-xs"></i>
                </button>
                <div id="languageDropdown" class="language-dropdown absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-100 z-50">
                    {% for lang in languages %}
                    <form method="POST" action="/language/change" class="block">
                        <input type="hidden" name="language" value="{{ lang.code }}">
                        <input type="hidden" name="redirect" value="{{ current_uri }}">
                        <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center {% if lang.code == current_language %}bg-brand-50 font-medium{% endif %}">
                            <span class="mr-2">{{ getFlag(lang.code) }}</span><span>{{ lang.name }}</span>
                            {% if lang.code == current_language %}<i class="fas fa-check text-brand-600 ml-auto"></i>{% endif %}
                        </button>
                    </form>
                    {% endfor %}
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 py-8">
            {% if uri != '' and uri != '/' and not (uri starts with '/dashboard') %}
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
                <button type="button" data-action="goBack" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700">
                    <i class="fas fa-arrow-left"></i> {{ t('common.back') }}
                </button>
            </div>
            {% endif %}
            {% block content %}{% endblock %}
        </main>
    </div>
    {% else %}
    <main class="min-h-screen">{{ block('content') }}</main>
    {% endif %}
    <!-- Custom Confirmation Modal -->
    <div id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto w-full z-[9999] items-center justify-center p-4" style="display:none;">
        <div class="w-full max-w-sm p-5 border shadow-lg rounded-md bg-white">
            <div class="mt-3 text-center">
                <div id="confirmModalIcon" class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100">
                    <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
                </div>
                <h3 class="text-lg leading-6 font-medium text-gray-900 mt-4" id="confirmModalTitle">Подтверждение</h3>
                <div class="mt-2 px-7 py-3">
                    <p class="text-sm text-gray-500" id="confirmModalMessage">Вы уверены?</p>
                </div>
                <div class="items-center px-4 py-3 flex justify-center gap-4">
                    <button id="confirmModalCancel" class="px-4 py-2 bg-gray-200 text-gray-800 text-base font-medium rounded-md shadow-sm hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-300">
                        Отмена
                    </button>
                    <button id="confirmModalOk" class="px-4 py-2 bg-red-600 text-white text-base font-medium rounded-md shadow-sm hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500">
                        Подтвердить
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast notifications -->
    <div id="toastContainer" class="fixed top-4 right-4 z-[10000] flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]"></div>


    <script nonce="{{ csp_nonce }}">
        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            const bd = document.getElementById('sidebarBackdrop');
            if (sb) sb.classList.toggle('-translate-x-full');
            if (bd) bd.classList.toggle('hidden');
        }

        function toggleTheme() {
            const dark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
        }

        // Loading state for a button (spinner + disabled). Used by AJAX flows:
        //   setBtnLoading(btn, true, 'Сохранение…'); ... setBtnLoading(btn, false);
        window.setBtnLoading = function (btn, on, text) {
            if (!btn) return;
            if (on) {
                if (btn.dataset._orig === undefined) btn.dataset._orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>' + (text ? ' ' + text : '');
            } else if (btn.dataset._orig !== undefined) {
                btn.disabled = false;
                btn.innerHTML = btn.dataset._orig;
                delete btn.dataset._orig;
            }
        };

        // Event delegation replacing inline on* handlers (CSP: no
        // unsafe-inline). Markup uses data-action="fnName" [data-on="change|
        // submit|input"]; the named window function is called with `this` = the
        // element and the event. Functions read any args from data-* on the
        // element.
        function _amnDispatch(e) {
            const el = e.target.closest('[data-action]');
            if (!el) return;
            if ((el.getAttribute('data-on') || 'click') !== e.type) return;
            const fn = el.getAttribute('data-action');
            if (typeof window[fn] === 'function') window[fn].call(el, e);
        }
        ['click', 'change', 'submit', 'input'].forEach(function (evt) {
            document.addEventListener(evt, _amnDispatch);
        });

        // Generic confirm-then-submit: data-confirm="msg" [data-confirm-title]
        // [data-confirm-ok] on an element; submits its closest form (or
        // data-confirm-target selector) when confirmed.
        document.addEventListener('click', function (e) {
            const el = e.target.closest('[data-confirm]');
            if (!el) return;
            e.preventDefault();
            const target = el.getAttribute('data-confirm-target');
            showConfirmModal(
                el.getAttribute('data-confirm'),
                el.getAttribute('data-confirm-title') || 'Подтверждение',
                el.getAttribute('data-confirm-ok') || 'Подтвердить'
            ).then(function (ok) {
                if (!ok) return;
                const form = target ? document.querySelector(target) : el.closest('form');
                if (form) form.submit();
            });
        });

        // Global: on any (valid) form submit, show a spinner on its submit
        // button and prevent double-submit. HTML5-invalid forms don't fire
        // 'submit', so this only triggers on real submissions; a safety timer
        // restores the button if the page didn't navigate (e.g. an AJAX form).
        document.addEventListener('submit', function (e) {
            const form = e.target;
            if (!(form instanceof HTMLFormElement) || form.dataset.noLoading !== undefined) return;
            const btn = form.querySelector('button[type="submit"], button:not([type]), input[type="submit"]');
            if (btn && !btn.disabled && btn.tagName === 'BUTTON') {
                window.setBtnLoading(btn, true, btn.dataset.loadingText || '');
                setTimeout(function () { window.setBtnLoading(btn, false); }, 8000);
            }
        });

        function toggleLanguageDropdown() {
            const dropdown = document.getElementById('languageDropdown');
            dropdown.classList.toggle('active');
        }

        // Back button: go to the previous page, or the dashboard if there is
        // no in-app history (e.g. the page was opened directly).
        function goBack() {
            if (window.history.length > 1 && document.referrer && new URL(document.referrer, location.origin).origin === location.origin) {
                window.history.back();
            } else {
                window.location.href = '/dashboard';
            }
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {
            const languageButton = event.target.closest('button[data-action="toggleLanguageDropdown"]');
            const dropdown = document.getElementById('languageDropdown');
            const isInsideDropdown = dropdown && dropdown.contains(event.target);
            
            // Don't close if clicking the button or inside dropdown (except submit buttons)
            if (!languageButton && !isInsideDropdown && dropdown) {
                dropdown.classList.remove('active');
            }
        });

        // Ensure dropdown stays open when form is being submitted
        document.addEventListener('submit', function(event) {
            if (event.target.closest('#languageDropdown')) {
                // Form will submit normally, dropdown will close on page reload
            }
        });

        // Custom confirmation modal function (replaces native confirm).
        // showConfirmModal(message, title, confirmText) -> Promise<bool>
        window.showConfirmModal = function(message, title, confirmText) {
            return new Promise((resolve) => {
                const modal = document.getElementById('confirmModal');
                const titleEl = document.getElementById('confirmModalTitle');
                const msgEl = document.getElementById('confirmModalMessage');
                const okBtn = document.getElementById('confirmModalOk');
                const cancelBtn = document.getElementById('confirmModalCancel');

                if (!modal) {
                    // Fallback to native confirm if modal not found
                    resolve(confirm(message));
                    return;
                }

                titleEl.textContent = title || 'Подтверждение';
                msgEl.textContent = message || 'Вы уверены?';
                okBtn.textContent = confirmText || 'Подтвердить';

                modal.style.display = 'flex';
                modal.classList.remove('hidden');
                okBtn.focus();

                function cleanup() {
                    modal.style.display = 'none';
                    modal.classList.add('hidden');
                    okBtn.removeEventListener('click', onOk);
                    cancelBtn.removeEventListener('click', onCancel);
                    modal.removeEventListener('click', onBackdrop);
                    document.removeEventListener('keydown', onKey);
                }

                function onOk() { cleanup(); resolve(true); }
                function onCancel() { cleanup(); resolve(false); }
                function onBackdrop(e) { if (e.target === modal) { cleanup(); resolve(false); } }
                function onKey(e) {
                    if (e.key === 'Escape') { cleanup(); resolve(false); }
                    else if (e.key === 'Enter') { cleanup(); resolve(true); }
                }

                okBtn.addEventListener('click', onOk);
                cancelBtn.addEventListener('click', onCancel);
                modal.addEventListener('click', onBackdrop);
                document.addEventListener('keydown', onKey);
            });
        };

        // Lightweight toast notifications (replaces alert() for feedback).
        // showToast(message, type) where type = 'success' | 'error' | 'info'
        // Shared HTML escaper for strings that go into innerHTML (server output,
        // API messages). Pages may still define their own with the same name.
        window.escapeHtml = window.escapeHtml || function (v) {
            return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
                return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c];
            });
        };
        window.showToast = function(message, type) {
            const container = document.getElementById('toastContainer');
            if (!container) { if (type === 'error') alert(message); return; }
            const styles = {
                success: { bg: 'bg-green-600', icon: 'fa-check-circle' },
                error:   { bg: 'bg-red-600',   icon: 'fa-exclamation-circle' },
                info:    { bg: 'bg-gray-800',  icon: 'fa-info-circle' }
            };
            const s = styles[type] || styles.info;
            const toast = document.createElement('div');
            toast.className = `${s.bg} text-white text-sm px-4 py-3 rounded-md shadow-lg flex items-start gap-2 transition-opacity duration-300`;
            toast.setAttribute('role', 'status');
            const icon = document.createElement('i');
            icon.className = `fas ${s.icon} mt-0.5`;
            const span = document.createElement('span');
            span.className = 'flex-1 whitespace-pre-line';
            span.textContent = message;
            toast.appendChild(icon);
            toast.appendChild(span);
            container.appendChild(toast);
            const remove = () => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); };
            toast.addEventListener('click', remove);
            setTimeout(remove, type === 'error' ? 6000 : 3500);
        };
    </script>

    {% block scripts %}{% endblock %}
    {% if flash_messages is defined and flash_messages %}
    <script nonce="{{ csp_nonce }}">
    document.addEventListener('DOMContentLoaded', function () {
      {% for f in flash_messages %}showToast({{ f.text|json_encode|raw }}, {{ f.type|json_encode|raw }});
      {% endfor %}
    });
    </script>
    {% endif %}
</body>
</html>
