}

// Update client speeds
async function updateClientSpeeds() {
  if (document.hidden) return;
  const clientRows = document.querySelectorAll('[id^="client-speed-"]');

  let metricsByClient = {};
  try {
    const response = await fetch(`/api/servers/${serverId}/client-metrics?hours=24&max_points_per_client=24`, {
      credentials: 'same-origin'
    });

    const data = await response.json();
    if (!data.success) {
      throw new Error(data.error || 'Failed to load client metrics');
    }

    for (const metric of data.metrics || []) {
      const key = String(metric.client_id);
      if (!metricsByClient[key]) {
        metricsByClient[key] = [];
      }
      metricsByClient[key].push(metric);
    }
  } catch (error) {
    console.error('Failed to fetch client metrics:', error);
    return;
  }

  for (const row of clientRows) {
    const clientId = row.id.replace('client-speed-', '');
    const metrics = metricsByClient[String(clientId)] || [];
    if (metrics.length === 0) {
      continue;
    }

    const latest = metrics[metrics.length - 1];
    const speedUp = (parseFloat(latest.speed_up_kbps) / 1000).toFixed(2);
    const speedDown = (parseFloat(latest.speed_down_kbps) / 1000).toFixed(2);

    row.innerHTML = `
        <div class="text-green-600 whitespace-nowrap">↑${speedUp} Mbit</div>
        <div class="text-blue-600 whitespace-nowrap">↓${speedDown} Mbit</div>
    `;
  }
}

