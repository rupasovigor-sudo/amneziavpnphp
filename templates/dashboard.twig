{% extends "layout.twig" %}
{% import "components/ui.twig" as ui %}

{% block title %}{{ t('dashboard.title') }} - {{ app_name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">{{ t('dashboard.title') }}</h1>
            <p class="mt-1 text-sm text-gray-500">{{ t('dashboard.welcome') }}</p>
        </div>
        <a href="/servers/create" class="btn-primary"><i class="fas fa-plus"></i>{{ t('servers.add') }}</a>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        {{ ui.stat(t('dashboard.total_servers'), servers|length, 'fa-server', 'blue') }}
        {{ ui.stat(t('dashboard.total_clients'), clients|length, 'fa-users', 'green') }}
        {{ ui.stat(t('dashboard.online_now'), online_count|default(0), 'fa-wifi', 'brand') }}
    </div>

    <!-- Recent Servers -->
    {% if servers|length > 0 %}
    <div class="card overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-900">{{ t('dashboard.recent_servers') }}</h2>
            <a href="/servers" class="text-sm text-brand-600 hover:text-brand-700">Все серверы →</a>
        </div>
        {% include 'servers/_server_table.twig' %}
    </div>
    {% else %}
    <div class="card p-12 text-center">
        <i class="fas fa-server text-gray-300 text-5xl mb-4"></i>
        <h3 class="text-lg font-medium text-gray-900 mb-1">{{ t('dashboard.no_servers') }}</h3>
        <p class="text-gray-500 mb-6">{{ t('dashboard.get_started') }}</p>
        <a href="/servers/create" class="btn-primary"><i class="fas fa-plus"></i>{{ t('dashboard.add_first_server') }}</a>
    </div>
    {% endif %}
</div>
{% endblock %}
