// Live online status: poll the active member's awg0 so the status badge and
// last-handshake reflect reality without waiting for the collector cycle.
const STATUS_LABELS = { active: '{{ t('status.active') }}', disabled: '{{ t('status.disabled') }}' };

// Sub-line under the status badge: the pool member the client is actually
// connected to. Highlighted when that is NOT the active member — that is the
// "client lingering on the old server after a switch" case, which is otherwise
// invisible until something breaks.
function connLine(cell) {
  const name = cell.dataset.connServer || '';
  if (!name) return '';
  const off = cell.dataset.connOffMember === '1';
  const esc = String(name).replace(/[&<>"]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
  return off
    ? `<div class="text-xs text-amber-700 mt-0.5" title="Клиент подключён не к активному серверу пула — переедет при переподключении"><i class="fas fa-arrow-turn-down mr-1"></i>${esc}</div>`
    : `<div class="text-xs text-gray-500 mt-0.5"><i class="fas fa-server mr-1"></i>${esc}</div>`;
}
function fmtHsAge(sec) {
  if (sec == null) return '—';
  if (sec < 60) return sec + 'с назад';
  if (sec < 3600) return Math.floor(sec / 60) + 'м назад';
  if (sec < 86400) return Math.floor(sec / 3600) + 'ч назад';
  return Math.floor(sec / 86400) + 'д назад';
}
async function refreshLiveStatus() {
  if (document.hidden) return; // don't drive SSH polls for a backgrounded tab
  try {
    const r = await fetch(`/servers/{{ server.id }}/clients/live-status`, { credentials: 'same-origin' });
    const d = await r.json();
    if (!d || !d.success || !d.peers) return;
    document.querySelectorAll('#clientsTableBody .client-row').forEach(row => {
      const pk = row.getAttribute('data-public-key');
      const peer = pk ? d.peers[pk] : null;
      const cell = row.querySelector('[data-status-cell]');
      if (cell) {
        const dbStatus = cell.getAttribute('data-client-status');
        // The server decides: it compares traffic received from the client, which
        // distinguishes "idle but connected" from "gone". handshake_age is only a
        // fallback for responses predating that field.
        const online = peer && (peer.online !== undefined
          ? peer.online
          : (peer.handshake_age != null && peer.handshake_age < (d.online_window || {{ online_window|default(180) }})));
        let html;
        if (online) {
          html = '<span class="online-badge inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 rounded text-xs"><i class="fas fa-wifi"></i>Online</span>';
        } else if (dbStatus === 'active') {
          html = '<span class="status-badge inline-flex items-center gap-1 px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs"><i class="fas fa-circle text-[7px]"></i>' + STATUS_LABELS.active + '</span>';
        } else {
          html = '<span class="status-badge inline-flex items-center gap-1 px-2 py-1 bg-red-100 text-red-800 rounded text-xs"><i class="fas fa-ban"></i>' + STATUS_LABELS.disabled + '</span>';
        }
        // Which pool member is actually carrying this client. Stored on the
        // cell so the other (coarser) poller renders the same sub-line instead
        // of wiping it.
        if (online && peer && peer.server_name) {
          cell.dataset.connServer = peer.server_name;
          cell.dataset.connOffMember = peer.is_active_member ? '' : '1';
        } else {
          cell.dataset.connServer = '';
          cell.dataset.connOffMember = '';
        }
        cell.innerHTML = html + connLine(cell);
      }
      const hsCell = row.querySelector('[data-hs-cell]');
      if (hsCell && peer && peer.handshake_age != null) {
        hsCell.innerHTML = '<span class="text-gray-600 block">' + fmtHsAge(peer.handshake_age) + '</span>';
      }
    });
  } catch (e) { /* keep server-rendered status on error */ }
}
if (document.querySelector('#clientsTableBody .client-row')) {
  refreshLiveStatus();
  setInterval(refreshLiveStatus, 45000);
}

async function diagnoseClient(clientId) {
  try {
    const response = await fetch(`/api/clients/${clientId}/diagnostics`, {
      credentials: 'same-origin'
    });
    const data = await response.json();
    if (!data.success) {
      showToast('Диагностика: ' + (data.error || 'ошибка'), 'error');
      return;
    }

    const header = [
      `Клиент: ${data.client.name}`,
      `IP: ${data.client.ip || '-'}`,
      `Протокол: ${data.client.protocol_slug || '-'}`,
      `Контейнер: ${data.client.container_name || '-'}`
    ];
    const checks = (data.checks || []).map(check => {
      const status = check.ok ? 'OK' : 'FAIL';
      return `${status} ${check.name}: ${check.message}`;
    });

    showToast(header.concat('', checks).join('\n'), data.checks.every(c => c.ok) ? 'success' : 'error');
  } catch (e) {
    showToast('Диагностика: ' + e.message, 'error');
  }
}

// Real-time online status updates
async function updateOnlineStatus() {
  const serverId = {{ server.id }};
  try {
    const response = await fetch(`/api/servers/${serverId}/online`, {
      credentials: 'same-origin'
    });
    if (!response.ok) return;
    const data = await response.json();
    if (!data.success) return;
    
    const onlineSet = new Set(data.online);
    document.querySelectorAll('td[data-client-name]').forEach(cell => {
      const clientName = cell.dataset.clientName;
      const clientStatus = cell.dataset.clientStatus;
      
      // This poller knows names only, not which member serves them. Render the
      // sub-line from the value the richer poller stored on the cell instead of
      // wiping it — two pollers fighting over one cell is what made statuses
      // flicker before.
      let badge;
      if (onlineSet.has(clientName)) {
        badge = '<span class="online-badge px-2 py-1 bg-green-100 text-green-800 rounded text-xs"><i class="fas fa-wifi mr-1"></i>Online</span>';
      } else if (clientStatus === 'active') {
        badge = '<span class="status-badge px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">{{ t("status.active") }}</span>';
        cell.dataset.connServer = '';
      } else {
        badge = '<span class="status-badge px-2 py-1 bg-red-100 text-red-800 rounded text-xs">{{ t("status.disabled") }}</span>';
        cell.dataset.connServer = '';
      }
      cell.innerHTML = badge + connLine(cell);
    });
  } catch (e) {
    console.error('Failed to update online status:', e);
  }
}

// Poll every 5 seconds
setInterval(updateOnlineStatus, 15000);
