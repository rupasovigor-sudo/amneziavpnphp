{% extends "layout.twig" %}
{% import "components/ui.twig" as ui %}
{% block title %}Пулы{% endblock %}

{% block content %}
{{ ui.page_header('Пулы серверов', 'Точки входа, маршруты, серверы выхода и готовность резерва') }}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="card p-4 mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="font-semibold text-gray-900">Общая схема подключения</div>
      <div class="text-sm text-gray-500 mt-0.5">Клиент → домен пула → RU-фронт или прямой вход → активный сервер → WARP или прямой интернет</div>
    </div>
    <div class="flex flex-wrap gap-2 text-xs">
      <span class="badge-brand"><i class="fas fa-layer-group mr-1"></i>{{ pools|length }} пул(а)</span>
      <span class="badge-gray"><i class="fas fa-right-to-bracket mr-1"></i>{{ fronts|filter(f => f)|length }} с фронтом</span>
    </div>
  </div>

  {% for p in pools %}
  {% set pool = p.pool %}
  {% set fs = fronts[pool.id] ?? null %}
  {% set active = p.members|filter(m => m.role == 'active')|first %}
  {% set ready_standby = p.members|filter(m => m.role == 'standby' and m.status == 'active' and not m.sync_pending and m.validated_clean == 1)|length %}
  {% set sync_errors = p.members|filter(m => m.sync_pending)|length %}
  <div class="card mb-6 overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-lg font-semibold text-gray-900">{{ pool.name }}</h2>
          <span class="badge-gray">#{{ pool.id }}</span>
          {% if fs and fs.front.dns_mode == 'front' %}<span class="badge-brand">через RU-фронт</span>{% else %}<span class="badge-gray">прямой вход</span>{% endif %}
          {% if sync_errors %}<span class="badge-yellow"><i class="fas fa-triangle-exclamation mr-1"></i>рассинхрон: {{ sync_errors }}</span>{% endif %}
        </div>
        <div class="text-sm text-gray-500 mt-1">{{ p.members|length }} сервер(а) · ACTIVE: <span class="font-medium text-gray-700">{{ active.name|default('не выбран') }}</span>{% if ready_standby %} · готовых резервов: {{ ready_standby }}{% endif %}</div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        {% if active %}<a href="/servers/{{ active.id }}" class="btn-primary"><i class="fas fa-server"></i>Открыть ACTIVE</a>{% endif %}
      </div>
    </div>

    <div class="p-5 border-b border-gray-100">
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
        <div class="rounded-lg border border-sky-200 bg-sky-50 p-3 min-w-0">
          <div class="text-[10px] font-semibold uppercase tracking-wide text-sky-700 mb-2"><i class="fas fa-link mr-1"></i>Адреса подключения</div>
          <div class="space-y-1.5">
            <div class="flex items-center gap-2 min-w-0"><span class="px-1.5 py-0.5 rounded bg-white border border-sky-200 text-[10px] font-semibold text-sky-700 flex-shrink-0">AWG 2.0</span><span class="font-mono font-semibold text-xs truncate">{{ pool.domain ?: 'домен не задан' }}:{{ pool.vpn_port|default(443) }}</span></div>
            <div class="flex items-center gap-2 min-w-0"><span class="px-1.5 py-0.5 rounded bg-white border border-indigo-200 text-[10px] font-semibold text-indigo-700 flex-shrink-0">AWG 3.1</span><span class="font-mono font-semibold text-xs truncate">{{ pool.domain ?: 'домен не задан' }}:{{ pool.awg31_port|default(444) }}</span></div>
          </div>
          <div class="text-xs text-gray-500 mt-2">Сети: <span class="font-mono">{{ pool.vpn_subnet }}</span> / <span class="font-mono">{{ pool.awg31_subnet|default('10.8.31.0/24') }}</span></div>
        </div>

        <div class="rounded-lg border border-indigo-200 bg-indigo-50 p-3 min-w-0">
          <div class="text-[10px] font-semibold uppercase tracking-wide text-indigo-700 mb-1"><i class="fas fa-route mr-1"></i>Маршрут</div>
          {% if fs and fs.front.dns_mode == 'front' %}
            <div class="font-semibold text-sm text-gray-900 truncate">{{ fs.front.server_name }}</div>
            <div class="text-xs text-gray-600 mt-1 truncate"><span class="font-mono">{{ fs.front.server_host }}</span> → {{ active.name|default('ACTIVE') }}</div>
          {% else %}
            <div class="font-semibold text-sm text-gray-900">Прямой вход</div>
            <div class="text-xs text-gray-600 mt-1 truncate">{{ pool.domain ?: 'домен' }} → {{ active.name|default('ACTIVE не выбран') }}</div>
          {% endif %}
          <div class="text-xs mt-2 {{ active.status|default('') == 'active' ? 'text-green-700' : 'text-red-700' }}"><i class="fas fa-circle text-[7px] mr-1"></i>выходной сервер {{ active.status|default('не определён') }}</div>
        </div>

        <div class="rounded-lg border border-gray-200 bg-gray-50 p-3 min-w-0">
          <div class="text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1"><i class="fas fa-globe mr-1"></i>DNS</div>
          <div class="font-mono font-semibold text-xs text-gray-900 break-all">{{ p.resolved_ips|join(', ') ?: 'IP не найден' }}</div>
          <div class="text-xs mt-2 {{ p.provider_configured ? 'text-green-700' : 'text-amber-700' }}">{% if p.provider_configured %}<i class="fas fa-check-circle mr-1"></i>провайдер подключён{% else %}<i class="fas fa-triangle-exclamation mr-1"></i>провайдер не настроен{% endif %}</div>
        </div>

        <div class="rounded-lg border {{ ready_standby ? 'border-green-200 bg-green-50' : 'border-amber-200 bg-amber-50' }} p-3 min-w-0">
          <div class="text-[10px] font-semibold uppercase tracking-wide {{ ready_standby ? 'text-green-700' : 'text-amber-700' }} mb-1"><i class="fas fa-shield-halved mr-1"></i>Отказоустойчивость</div>
          {% if p.members|length == 1 %}
            <div class="font-semibold text-sm text-gray-900">Один сервер</div><div class="text-xs text-gray-600 mt-1">Резервного выхода пока нет</div>
          {% elseif ready_standby %}
            <div class="font-semibold text-sm text-gray-900">Резерв готов</div><div class="text-xs text-gray-600 mt-1">{{ ready_standby }} сервер(а) готовы к failover</div>
          {% else %}
            <div class="font-semibold text-sm text-gray-900">Резерв не готов</div><div class="text-xs text-gray-600 mt-1">Проверьте синхрон и репутацию</div>
          {% endif %}
        </div>
      </div>
    </div>

    {# Egress policy for the whole pool #}
    <div class="px-5 py-4 border-b border-gray-100 bg-white flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="min-w-0">
        <div class="font-medium text-sm text-gray-900"><i class="fas fa-arrow-up-right-from-square mr-1 text-brand-600"></i>Выход в интернет</div>
        <div class="text-xs text-gray-500 mt-1 leading-relaxed">Cloudflare WARP{% if p.members|filter(m => not m.warp_enabled)|length %}; на части серверов выбран прямой выход{% endif %}. Google {% if pool.warp_bypass_google ?? 1 %}идёт напрямую с IP выходного сервера{% else %}также идёт через WARP{% endif %}.</div>
      </div>
      <label class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border bg-gray-50 cursor-pointer select-none text-sm flex-shrink-0">
        <input type="checkbox" class="js-warp-bypass rounded border-gray-300 text-brand-600 focus:ring-brand-500" data-pool="{{ pool.id }}" {{ (pool.warp_bypass_google ?? 1) ? 'checked' }}>
        <span>Google напрямую</span>
      </label>
    </div>

    <div class="px-5 py-4 border-b border-gray-100">
      <div class="flex items-center justify-between gap-3 mb-3">
        <div><div class="font-semibold text-gray-900"><i class="fas fa-server mr-1 text-brand-600"></i>Серверы пула</div><div class="text-xs text-gray-500 mt-0.5">Роль, синхронизация, репутация IP и готовность к переключению</div></div>
        <span class="badge-gray">{{ p.members|length }}</span>
      </div>
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-3">
        {% for m in p.members %}
        {% set ready = m.status == 'active' and not m.sync_pending and m.validated_clean == 1 %}
        {% set rep = reputation[m.id] %}
        <div class="rounded-lg border p-3 bg-white">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <a href="/servers/{{ m.id }}" class="font-semibold text-gray-900 hover:text-brand-600">{{ m.name }}</a>
                {% if m.role == 'active' %}<span class="badge-brand">ACTIVE</span>{% else %}<span class="badge-gray">STANDBY</span>{% endif %}
                {% if fs and fs.front.dns_mode == 'front' and m.role == 'active' %}<span class="badge-brand"><i class="fas fa-right-to-bracket mr-1"></i>через фронт</span>{% elseif m.dns_points_here %}<span class="badge-green">DNS сюда</span>{% endif %}
              </div>
              <div class="text-xs text-gray-500 font-mono mt-1">{{ m.host }} · #{{ m.id }} · приоритет {{ m.priority }}</div>
              <div class="flex flex-wrap gap-1.5 mt-2">
                <span class="{{ m.status == 'active' ? 'badge-green' : 'badge-red' }}">{{ m.status }}</span>
                {% if m.sync_pending %}<span class="badge-red">ожидает синхронизации</span>{% else %}<span class="badge-green">синхрон OK</span>{% endif %}
                {% if m.warp_enabled %}<span class="px-2 py-0.5 rounded text-xs bg-violet-100 text-violet-700">выход WARP</span>{% else %}<span class="badge-gray">прямой выход</span>{% endif %}
              </div>
            </div>
            <div class="sm:text-right flex-shrink-0">
              {% if m.role == 'active' %}<span class="text-xs text-gray-500">текущий выход</span>
              {% elseif ready %}<span class="badge-green">готов к failover</span>
              {% else %}<span class="badge-red">не готов к failover</span>{% endif %}
              <div class="mt-2 text-xs">
                {% if m.validated_clean == 1 %}<span class="text-green-700"><i class="fas fa-check mr-1"></i>канарейка: чистый</span>
                {% elseif m.validated_clean is null %}<span class="text-gray-500">канарейка: не проверен</span>
                {% else %}<span class="text-red-700"><i class="fas fa-xmark mr-1"></i>канарейка: не прошёл</span>{% endif %}
              </div>
              <div class="mt-1 text-xs">
                {% if rep is null %}<span class="text-gray-500">репутация: не проверялась</span>
                {% else %}
                  {% set listed = rep.listed_on %}{% set score = rep.abuse_score %}
                  {% if listed|length > 0 or (score is not null and score >= 50) %}<span class="text-red-700" title="{{ listed|join(', ') }}">репутация: блок-листы{% if score is not null %} ({{ score }}){% endif %}</span>{% else %}<span class="text-green-700">репутация: чист</span>{% endif %}
                {% endif %}
              </div>
            </div>
          </div>
          {% if m.validation_note %}<div class="mt-2 pt-2 border-t text-xs text-gray-400 break-words">{{ m.validation_note }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>

    {# ── Router AllowedIPs (full tunnel minus every pool endpoint) ── #}
    <div class="border-t border-gray-100 px-5 py-4 js-aip" data-pool="{{ pool.id }}">
      <details>
        <summary class="text-sm font-medium text-gray-800 cursor-pointer"><i class="fas fa-route mr-1 text-brand-600"></i>AllowedIPs для роутера — full-tunnel без IP пула</summary>
        <div class="mt-3 space-y-2 text-sm">
          <p class="text-gray-500 leading-snug">
            Для full-tunnel конфига роутера (MikroTik, Keenetic и т.п.): из <code>0.0.0.0/0</code> вычитаются IP <b>всех серверов пула</b>
            ({% for m in p.members %}<span class="font-mono">{{ m.host }}</span>{{ not loop.last ? ', ' }}{% else %}—{% endfor %}{% if fronts[pool.id] ?? null %}, фронт <span class="font-mono">{{ fronts[pool.id].front.server_host }}</span>{% endif %})
            и локальные исключения ниже, чтобы туннель не заворачивал сам себя. Конфиг переживает переключение активного сервера; <b>перегенерируйте его после добавления нового сервера в пул</b>.
          </p>
          <label class="block text-gray-600">Локальные исключения — по одному CIDR в строке (свой адрес, LAN, docker-сети):</label>
          <textarea class="js-aip-extra w-full border rounded px-2 py-1 font-mono" rows="3">10.8.1.8/32
172.18.20.0/30</textarea>
          <button type="button" class="js-aip-gen btn-secondary"><i class="fas fa-gears"></i>Сгенерировать</button>
          <div class="js-aip-out" hidden>
            <div class="flex items-center justify-between mb-1 gap-2 flex-wrap">
              <span class="text-gray-500">Замените строку <code>AllowedIPs = …</code> в секции <code>[Peer]</code> конфига роутера:</span>
              <button type="button" class="js-aip-copy btn-secondary"><i class="fas fa-copy"></i>Копировать</button>
            </div>
            <textarea class="js-aip-result w-full border rounded px-2 py-1 font-mono bg-gray-50" rows="4" readonly></textarea>
            <p class="js-aip-meta text-gray-400 mt-1"></p>
          </div>
        </div>
      </details>
    </div>

    {# ── RU-фронт (entry relay) ── #}
    {% set countries = ['DE','US','FI','SE','NL','GB','FR','PL','EE','LV','LT','TR','KZ'] %}
    <div class="border-t border-gray-100 px-5 py-4 bg-gray-50/50">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="font-semibold text-gray-900"><i class="fas fa-right-to-bracket mr-1 text-brand-600"></i>RU-фронт</div>
          {% if fs %}
            <div class="text-xs text-gray-500 mt-1"><span class="font-medium text-gray-700">{{ fs.front.server_name }}</span> · <span class="font-mono">{{ fs.front.server_host }}</span> · домен {% if fs.front.dns_mode == 'front' %}на фронте{% else %}на активном сервере{% endif %}</div>
          {% else %}
            <div class="text-xs text-gray-500 mt-1">Фронт не подключён — клиенты входят напрямую на сервер пула.</div>
          {% endif %}
        </div>
        <div class="flex flex-wrap items-center gap-2">
          {% if fs %}
            {% if fs.down %}<span class="badge-red">фронт недоступен</span>{% else %}<span class="badge-green">relay работает</span>{% endif %}
            {% if fs.front.e2e_checked_at is null %}<span class="badge-gray js-front-summary-status" data-pool="{{ pool.id }}">автотест не запускался</span>{% elseif fs.front.e2e_ok %}<span class="badge-green js-front-summary-status" data-pool="{{ pool.id }}">автотест: данные проходят</span>{% else %}<span class="badge-yellow js-front-summary-status" data-pool="{{ pool.id }}">автотест не подтверждён</span>{% endif %}
          {% else %}
            <span class="badge-gray">не настроен</span>
          {% endif %}
        </div>
      </div>
      <details class="mt-3 rounded-lg border bg-white px-4 py-3">
        <summary class="cursor-pointer text-sm font-medium text-gray-800 select-none"><i class="fas fa-sliders mr-1 text-brand-600"></i>{% if fs %}Настройки и диагностика фронта{% else %}Подключить RU-фронт{% endif %}</summary>
        <div class="mt-4">
      {% if not fs %}
        <p class="text-sm text-gray-500 mb-3 leading-snug">
          Клиенты подключаются к серверу-фронту (например, в РФ), а он прозрачно пересылает трафик на серверы этого пула — выход в интернет остаётся через пул и WARP.
          Ключи на фронте не хранятся. Подойдёт чистый Ubuntu: панель сама поставит relay. Домен пула не переключается, пока вы не нажмёте кнопку.
        </p>
        <form class="js-front-register grid grid-cols-1 md:grid-cols-3 gap-3 text-sm" data-pool="{{ pool.id }}">
          <label class="block">Название <input name="name" class="mt-1 w-full px-2 py-1.5 border rounded" placeholder="ru-front-1"></label>
          <label class="block">IPv4 фронта <input name="host" required class="mt-1 w-full px-2 py-1.5 border rounded font-mono" placeholder="85.192.56.6"></label>
          <label class="block">Основная страна выхода
            <select name="primary_country" class="mt-1 w-full px-2 py-1.5 border rounded">
              {% for c in countries %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
            </select></label>
          <label class="block">SSH-порт <input name="port" type="number" value="22" class="mt-1 w-full px-2 py-1.5 border rounded"></label>
          <label class="block">Пользователь <input name="username" value="root" class="mt-1 w-full px-2 py-1.5 border rounded"></label>
          <label class="block">Пароль <input name="password" type="password" autocomplete="new-password" class="mt-1 w-full px-2 py-1.5 border rounded" placeholder="или SSH-ключ ниже"></label>
          <label class="block md:col-span-3">Приватный SSH-ключ
            <textarea name="ssh_key" rows="5" class="mt-1 w-full px-2 py-1.5 border rounded font-mono text-xs" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
            <span class="block mt-1 text-xs text-gray-500">Укажите пароль или ключ. Для production рекомендуется отдельный ключ без passphrase.</span>
          </label>
          <div class="md:col-span-3">
            <button type="submit" class="btn-primary"><i class="fas fa-plug"></i>Подключить фронт</button>
            <span class="text-xs text-gray-400 ml-2">установка занимает до пары минут</span>
          </div>
        </form>
      {% else %}
        {% set f = fs.front %}
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 text-sm mb-4">
          <div class="rounded-lg border bg-gray-50 p-3">
            <div class="text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Фронт</div>
            <div class="font-medium text-gray-900">{{ f.server_name }}</div>
            <div class="font-mono text-xs text-gray-500 mt-0.5">{{ f.server_host }}</div>
            <div class="flex gap-1.5 mt-2"><span class="{{ fs.health.ssh ? 'badge-green' : 'badge-red' }}">SSH {{ fs.health.ssh ? 'OK' : 'ошибка' }}</span><span class="{{ fs.health.front_relay ? 'badge-green' : 'badge-red' }}">relay {{ fs.health.front_relay ? 'OK' : 'ошибка' }}</span></div>
          </div>
          <div class="rounded-lg border bg-gray-50 p-3">
            <div class="text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Точка входа домена</div>
            {% if f.dns_mode == 'front' %}
              <span class="badge-brand">RU-фронт</span>
              <div class="mt-2"><button type="button" class="btn-secondary js-front-act" data-pool="{{ pool.id }}" data-act="domain" data-body='{"target":"member"}' data-confirm-text="Вернуть домен пула напрямую на активный сервер? Клиенты перестанут входить через фронт (после переподключения).">Вернуть на сервер</button></div>
            {% else %}
              <span class="badge-gray">активный сервер</span>
              <div class="mt-2"><button type="button" class="btn-primary js-front-act" data-pool="{{ pool.id }}" data-act="domain" data-body='{"target":"front"}' data-confirm-text="Переключить домен пула на RU-фронт {{ f.server_host }}? Клиенты начнут входить через него после переподключения. Конфиги менять не нужно.">Направить на фронт</button></div>
            {% endif %}
          </div>
          <div class="rounded-lg border bg-gray-50 p-3">
            <div class="text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Основная страна выхода</div>
            <select class="js-front-country mt-1 w-full px-2 py-1.5 border rounded bg-white" data-pool="{{ pool.id }}">
              {% set cl = countries|merge([f.primary_country])|merge(fs.calc.members|map(m => m.egress_country)|filter(c => c))|reduce((acc, c) => c in acc ? acc : acc|merge([c]), []) %}
              {% for c in cl %}<option value="{{ c }}" {{ c == f.primary_country ? 'selected' }}>{{ c }}</option>{% endfor %}
            </select>
            <div class="text-xs text-gray-500 mt-1">остальные страны используются как резерв</div>
          </div>
          <div class="rounded-lg border bg-gray-50 p-3">
            <div class="text-[10px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Текущая группа</div>
            {% if fs.calc.tier == 'primary' %}<span class="badge-green">основная</span>
            {% elseif fs.calc.tier == 'reserve' %}<span class="badge-yellow">резервная</span>
            {% else %}<span class="badge-red">нет здоровых серверов</span>{% endif %}
            <div class="text-xs text-gray-500 mt-2 break-words">{{ f.last_push_msg ?: 'нет данных синхронизации' }}{% if f.last_push_at %} · {{ f.last_push_at }}{% endif %}</div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 mb-4">
          <div class="rounded-lg border border-green-200 bg-green-50/50 p-4">
            <div class="font-medium text-sm text-gray-900"><i class="fas fa-users mr-1 text-green-700"></i>Реальные подключения</div>
            <div class="js-front-clients mt-2 text-sm" data-pool="{{ pool.id }}"><span class="text-gray-500"><i class="fas fa-spinner fa-spin mr-1"></i>Проверяю активные подключения…</span></div>
          </div>
          <div class="rounded-lg border {{ f.e2e_ok is same as(0) ? 'border-amber-200 bg-amber-50/50' : 'border-gray-200 bg-gray-50' }} p-4">
            <div class="flex items-center justify-between gap-2">
              <div class="font-medium text-sm text-gray-900"><i class="fas fa-flask mr-1 text-brand-600"></i>Синтетический тест AWG 2.0</div>
              <button type="button" class="btn-secondary js-front-act" data-pool="{{ pool.id }}" data-act="e2e"><i class="fas fa-play"></i>Запустить</button>
            </div>
            <div class="mt-2 flex items-center gap-2 flex-wrap text-sm">
              {% if f.e2e_checked_at is null %}<span class="badge-gray">не запускался</span>
              {% elseif f.e2e_ok %}<span class="badge-green">контрольный трафик прошёл</span>
              {% else %}<span class="badge-yellow">контрольный объём не набран</span>{% endif %}
              {% if f.e2e_checked_at %}<span class="text-xs text-gray-400">{{ f.e2e_checked_at }} UTC</span>{% endif %}
            </div>
            {% if f.e2e_message %}<div class="text-xs text-gray-600 mt-2 break-words">{{ f.e2e_message }}</div>{% endif %}
            <div class="text-xs text-gray-500 mt-2">Это отдельный пробный клиент панели. Его ошибка не означает, что реальные клиенты не работают; фактические подключения показаны слева.</div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 mb-4">
          <div class="rounded-lg border p-4">
            <div class="font-medium text-sm text-gray-900"><i class="fas fa-lock mr-1 text-brand-600"></i>Политика входа</div>
            <div class="text-xs text-gray-500 mt-1 mb-3">Разрешать прямое подключение к выходным серверам или принимать клиентов только через фронт.</div>
            {% if f.members_front_only %}
              <div class="mb-3"><span class="badge-green"><i class="fas fa-lock mr-1"></i>только через фронт</span></div>
              <button type="button" class="btn-secondary js-front-act" data-pool="{{ pool.id }}" data-act="front-only" data-body='{"enabled":false}' data-confirm-text="Снова разрешить прямые подключения к серверам пула (в обход фронта)?">Разрешить прямой вход</button>
            {% else %}
              <div class="mb-3"><span class="badge-yellow">прямой вход разрешён</span></div>
              <button type="button" class="btn-primary js-front-act" data-pool="{{ pool.id }}" data-act="front-only" data-body='{"enabled":true}' {{ f.dns_mode != 'front' ? 'disabled title="Сначала направьте домен на фронт"' }} data-confirm-text="Серверы пула будут принимать VPN-подключения только от фронта. Устройства, подключённые напрямую, сразу потеряют связь и после переподключения VPN пойдут через фронт. Если фронт упадёт и домен уйдёт на сервер, прямой доступ откроется автоматически. Продолжить?"><i class="fas fa-right-to-bracket"></i>Принимать только через фронт</button>
            {% endif %}
          </div>
          <div class="rounded-lg border p-4 js-bport" data-pool="{{ pool.id }}">
            <div class="font-medium text-sm text-gray-900"><i class="fas fa-network-wired mr-1 text-brand-600"></i>Транспорт фронт → сервер</div>
            <div class="text-xs text-gray-500 mt-1">Клиенты входят на {{ pool.domain }}:{{ pool.vpn_port }}. Backend-порт используется только между фронтом и AWG 2.0 на выходном сервере.</div>
            <div class="flex items-center gap-2 mt-3">
              <input type="number" min="1024" max="65535" class="js-bport-val w-28 px-2 py-1.5 border rounded font-mono" value="{{ f.backend_port }}" placeholder="{{ pool.vpn_port }}">
              <button type="button" class="js-bport-save btn-secondary">Применить</button>
            </div>
            <label class="mt-3 inline-flex items-start gap-2 text-xs text-gray-600 cursor-pointer"><input type="checkbox" class="js-auto-port mt-0.5 rounded border-gray-300 text-brand-600" data-pool="{{ pool.id }}" {{ f.auto_port ? 'checked' }}><span>Автоматически менять backend-порт AWG 2.0 после двух неудачных синтетических тестов</span></label>
            {% if fs.blocked_ports %}<div class="text-xs text-gray-500 mt-2">Исключённые порты: <span class="font-mono">{{ fs.blocked_ports|join(', ') }}</span></div>{% endif %}
          </div>
        </div>

        <details class="rounded-lg border bg-gray-50 px-4 py-3">
          <summary class="cursor-pointer text-sm font-medium text-gray-800"><i class="fas fa-gears mr-1 text-brand-600"></i>Ротация серверов и техническое обслуживание</summary>
          <div class="mt-3 overflow-x-auto rounded border bg-white">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-gray-600">
              <tr>
                <th class="px-3 py-2 text-left font-medium">Сервер пула</th>
                <th class="px-3 py-2 text-left font-medium">Страна выхода</th>
                <th class="px-3 py-2 text-left font-medium">Группа</th>
                <th class="px-3 py-2 text-left font-medium">В ротации</th>
                <th class="px-3 py-2 text-left font-medium">Примечание</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {% for m in fs.calc.members %}
              <tr class="hover:bg-gray-50">
                <td class="px-3 py-2"><div class="font-medium">{{ m.name }}</div><div class="text-xs text-gray-500 font-mono">{{ m.host }}</div></td>
                <td class="px-3 py-2">
                  {% if m.egress_country %}<span class="font-medium">{{ m.egress_country }}</span>{% else %}<span class="text-gray-400">не определена</span>{% endif %}
                  {% if m.egress_ip %}<div class="text-xs text-gray-400 font-mono">{{ m.egress_ip }}</div>{% endif %}
                </td>
                <td class="px-3 py-2">
                  <select class="js-front-group px-2 py-1 border rounded" data-pool="{{ pool.id }}" data-server="{{ m.id }}">
                    <option value="auto" {{ m.relay_group is null ? 'selected' }}>авто ({{ m.group == 'primary' ? 'основная' : 'резерв' }})</option>
                    <option value="primary" {{ m.relay_group == 'primary' ? 'selected' }}>основная</option>
                    <option value="reserve" {{ m.relay_group == 'reserve' ? 'selected' }}>резерв</option>
                    <option value="off" {{ m.relay_group == 'off' ? 'selected' }}>выключен</option>
                  </select>
                </td>
                <td class="px-3 py-2">{% if m.in_rotation %}<span class="badge-green">да</span>{% else %}<span class="badge-gray">нет</span>{% endif %}</td>
                <td class="px-3 py-2 text-xs text-gray-500">{{ m.reason }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          </div>
          <div class="mt-3 flex items-center gap-2 flex-wrap">
            <button type="button" class="btn-secondary js-front-act" data-pool="{{ pool.id }}" data-act="sync"><i class="fas fa-rotate"></i>Синхронизировать</button>
            <button type="button" class="btn-secondary js-front-act" data-pool="{{ pool.id }}" data-act="detect"><i class="fas fa-earth-europe"></i>Определить страны</button>
            <button type="button" class="btn-secondary js-front-act" data-pool="{{ pool.id }}" data-act="reinstall" data-confirm-text="Переустановить relay на фронте (идемпотентно)?"><i class="fas fa-screwdriver-wrench"></i>Переустановить relay</button>
            <button type="button" class="btn-danger js-front-act sm:ml-auto" data-pool="{{ pool.id }}" data-act="remove" data-confirm-text="Отвязать фронт от пула? Relay на нём будет очищен. Домен должен уже указывать на сервер."><i class="fas fa-link-slash"></i>Отвязать фронт</button>
          </div>
          <p class="mt-2 text-xs text-gray-500 leading-snug">Панель каждую минуту исключает из ротации упавшие или рассинхронизированные серверы. Если недоступен сам фронт, домен автоматически возвращается на здоровый сервер.</p>
        </details>
      {% endif %}
        </div>
      </details>
    </div>
  </div>
  {% else %}
  {{ ui.empty_state('fa-layer-group', 'Пулов пока нет', '') }}
  {% endfor %}
</div>

<script nonce="{{ csp_nonce }}">
(function () {
  function post(poolId, act, body) {
    return fetch('/pools/' + poolId + '/front/' + act, {
      method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body || {})
    }).then(function (r) { return r.json(); });
  }
  function done(d, reload) {
    var ok = d && d.success;
    showToast((d && (d.message || d.error)) || (ok ? 'Готово' : 'Ошибка'), ok ? 'success' : 'error');
    if (ok && reload) setTimeout(function () { location.reload(); }, 1200);
  }

  document.querySelectorAll('.js-front-register').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      var body = {};
      new FormData(form).forEach(function (v, k) { body[k] = v; });
      setBtnLoading(btn, true, 'Установка relay…');
      post(form.dataset.pool, 'register', body)
        .then(function (d) { done(d, true); })
        .catch(function (err) { showToast('Ошибка: ' + err, 'error'); })
        .finally(function () { setBtnLoading(btn, false); });
    });
  });

  document.querySelectorAll('.js-front-act').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var confirmText = btn.dataset.confirmText;
      if (confirmText && !(await showConfirmModal(confirmText, 'Подтверждение', 'Да'))) return;
      var body = {};
      try { body = btn.dataset.body ? JSON.parse(btn.dataset.body) : {}; } catch (e) {}
      setBtnLoading(btn, true);
      post(btn.dataset.pool, btn.dataset.act, body)
        .then(function (d) { done(d, true); })
        .catch(function (err) { showToast('Ошибка: ' + err, 'error'); })
        .finally(function () { setBtnLoading(btn, false); });
    });
  });

  document.querySelectorAll('.js-front-group').forEach(function (sel) {
    sel.addEventListener('change', function () {
      sel.disabled = true;
      post(sel.dataset.pool, 'group', {server_id: Number(sel.dataset.server), group: sel.value})
        .then(function (d) { done(d, true); })
        .catch(function (err) { showToast('Ошибка: ' + err, 'error'); })
        .finally(function () { sel.disabled = false; });
    });
  });

  document.querySelectorAll('.js-auto-port').forEach(function (cb) {
    cb.addEventListener('change', function () {
      post(cb.dataset.pool, 'auto-port', {enabled: cb.checked})
        .then(function (d) { showToast(d.message || 'Готово', d.success ? 'success' : 'error'); })
        .catch(function (e) { cb.checked = !cb.checked; showToast('Ошибка: ' + e, 'error'); });
    });
  });

  document.querySelectorAll('.js-bport').forEach(function (box) {
    var btn = box.querySelector('.js-bport-save');
    btn.addEventListener('click', async function () {
      var val = box.querySelector('.js-bport-val').value.trim();
      var ok = await showConfirmModal('Сменить порт участка фронт → серверы на ' + (val || 'порт пула') + '? Все клиенты через фронт на пару секунд переподключатся.', 'Порт фронт → серверы', 'Применить');
      if (!ok) return;
      setBtnLoading(btn, true);
      post(box.dataset.pool, 'backend-port', {port: val})
        .then(function (d) { done(d, true); })
        .catch(function (e) { showToast('Ошибка: ' + e, 'error'); })
        .finally(function () { setBtnLoading(btn, false); });
    });
  });

  // Which live clients come through the front and which bypass it.
  function formatBytes(bytes) {
    bytes = Number(bytes || 0);
    if (bytes < 1024) return bytes + ' Б';
    if (bytes < 1048576) return Math.round(bytes / 1024) + ' КБ';
    if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' МБ';
    return (bytes / 1073741824).toFixed(1) + ' ГБ';
  }
  document.querySelectorAll('.js-front-clients').forEach(function (box) {
    fetch('/pools/' + box.dataset.pool + '/front/clients', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.success) { box.innerHTML = '<span class="text-red-600">' + escapeHtml(d.error || 'Ошибка') + '</span>'; return; }
        if (!d.front_mode) {
          box.innerHTML = '<span class="text-gray-500">Домен пула указывает на сервер, а не на фронт: все клиенты подключаются напрямую.</span>';
          return;
        }
        var via = d.via_front || [];
        var direct = d.direct || [];
        var summary = document.querySelector('.js-front-summary-status[data-pool="' + box.dataset.pool + '"]');
        if (via.length && summary) {
          summary.className = 'badge-green js-front-summary-status';
          summary.textContent = 'через фронт подключено: ' + via.length;
        }
        var html = '<div class="flex flex-wrap items-center gap-2">' +
          '<span class="badge-green">через фронт: ' + via.length + '</span>' +
          (direct.length ? '<span class="badge-yellow">в обход: ' + direct.length + '</span>' : '<span class="badge-gray">в обход: 0</span>') +
          '</div>';
        if (via.length) {
          html += '<div class="mt-2 text-xs text-green-800"><i class="fas fa-circle-check mr-1"></i>Свежие handshake приходят с IP фронта; счётчики туннелей: ' + formatBytes(d.via_front_bytes) + '.</div>';
          html += '<div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-gray-600">' + via.map(function (c) {
            return '<span><b>' + escapeHtml(c.name) + '</b> <span class="text-gray-400">' + escapeHtml(c.protocol || '') + ' → ' + escapeHtml(c.server) + '</span></span>';
          }).join('') + '</div>';
        } else {
          html += '<div class="mt-2 text-xs text-gray-500">За последние 3 минуты подключений через фронт не найдено. Это не ошибка, если клиенты сейчас выключены.</div>';
        }
        if (direct.length) {
          html += '<div class="mt-2 text-amber-800">' + direct.map(function (c) {
            return '<span class="inline-block mr-3"><i class="fas fa-triangle-exclamation mr-1"></i>' + escapeHtml(c.name) +
              ' <span class="text-gray-400 font-mono text-xs">' + escapeHtml(c.ip || '') + ' → ' + escapeHtml(c.server) + '</span></span>';
          }).join('') + '</div>' +
          '<div class="mt-1 text-xs text-gray-500">Эти устройства держат старый адрес и ходят напрямую на зарубежный сервер — при его блокировке они отвалятся первыми. Переподключите VPN на них, и они пойдут через фронт.</div>';
        }
        box.innerHTML = html;
      })
      .catch(function (e) { box.innerHTML = '<span class="text-red-600">Ошибка: ' + escapeHtml(String(e)) + '</span>'; });
  });

  document.querySelectorAll('.js-aip').forEach(function (box) {
    var gen = box.querySelector('.js-aip-gen');
    var result = box.querySelector('.js-aip-result');
    gen.addEventListener('click', function () {
      var extra = (box.querySelector('.js-aip-extra').value || '').trim();
      setBtnLoading(gen, true);
      fetch('/pools/' + box.dataset.pool + '/allowed-ips?exclude=' + encodeURIComponent(extra), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.success) { showToast(d.error || 'Ошибка', 'error'); return; }
          result.value = 'AllowedIPs = ' + d.allowed_ips;
          box.querySelector('.js-aip-meta').textContent =
            'Диапазонов: ' + (d.prefix_count || '?') + '. ' +
            'Исключено IP пула: ' + (d.member_ips || []).length + ' (' + (d.member_ips || []).join(', ') + '); всего исключений: ' + (d.excluded || []).length +
            '. Строка длинная — копируйте кнопкой, а не выделением.';
          box.querySelector('.js-aip-out').hidden = false;
          // Fit the whole list so it doesn't look truncated.
          result.style.height = 'auto';
          result.style.height = Math.min(result.scrollHeight + 4, 480) + 'px';
        })
        .catch(function (e) { showToast('Ошибка: ' + e, 'error'); })
        .finally(function () { setBtnLoading(gen, false); });
    });
    box.querySelector('.js-aip-copy').addEventListener('click', function () {
      result.select();
      (navigator.clipboard ? navigator.clipboard.writeText(result.value) : Promise.reject())
        .then(function () { showToast('Скопировано', 'success'); })
        .catch(function () { document.execCommand('copy'); showToast('Скопировано', 'success'); });
    });
  });

  document.querySelectorAll('.js-warp-bypass').forEach(function (cb) {
    cb.addEventListener('change', function () {
      cb.disabled = true;
      showToast('Применяю на серверах пула…', 'info');
      fetch('/pools/' + cb.dataset.pool + '/warp-bypass', {
        method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({enabled: cb.checked})
      }).then(function (r) { return r.json(); })
        .then(function (d) { done(d, true); })
        .catch(function (err) { showToast('Ошибка: ' + err, 'error'); cb.checked = !cb.checked; })
        .finally(function () { cb.disabled = false; });
    });
  });

  document.querySelectorAll('.js-front-country').forEach(function (sel) {
    sel.addEventListener('change', function () {
      sel.disabled = true;
      post(sel.dataset.pool, 'country', {country: sel.value})
        .then(function (d) { done(d, true); })
        .catch(function (err) { showToast('Ошибка: ' + err, 'error'); })
        .finally(function () { sel.disabled = false; });
    });
  });
})();
</script>
{% endblock %}
