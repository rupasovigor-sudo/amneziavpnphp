{#
  Shared UI components (Twig macros) for a consistent design system.
  Usage:
    {% import "components/ui.twig" as ui %}
    {{ ui.page_header('Заголовок', 'Подзаголовок') }}
    {{ ui.stat('Серверы', 3, 'fa-server', 'blue') }}
    {{ ui.empty_state('fa-server', 'Пусто', 'Добавьте первый сервер') }}
  For a header with action buttons, render the header inline (see dashboard.twig).
#}

{% macro page_header(title, subtitle) %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
  <h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
  {% if subtitle %}<p class="mt-1 text-sm text-gray-500">{{ subtitle }}</p>{% endif %}
</div>
{% endmacro %}

{% macro stat(label, value, icon, tone) %}
{% set tones = {
  'blue':'bg-blue-100 text-blue-600',
  'green':'bg-green-100 text-green-600',
  'brand':'bg-brand-100 text-brand-600',
  'yellow':'bg-yellow-100 text-yellow-600',
  'red':'bg-red-100 text-red-600',
  'gray':'bg-gray-100 text-gray-600'
} %}
<div class="card p-5 flex items-center gap-4">
  <div class="p-3 rounded-full {{ tones[tone]|default(tones.brand) }}"><i class="fas {{ icon }} text-xl"></i></div>
  <div>
    <p class="text-sm text-gray-500">{{ label }}</p>
    <p class="text-2xl font-bold text-gray-900">{{ value }}</p>
  </div>
</div>
{% endmacro %}

{% macro empty_state(icon, title, subtitle) %}
<div class="card p-12 text-center">
  <i class="fas {{ icon }} text-gray-300 text-5xl mb-4"></i>
  <h3 class="text-lg font-medium text-gray-900 mb-1">{{ title }}</h3>
  {% if subtitle %}<p class="text-gray-500">{{ subtitle }}</p>{% endif %}
</div>
{% endmacro %}
