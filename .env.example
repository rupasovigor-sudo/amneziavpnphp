# Environment Configuration
APP_ENV=local
APP_NAME="Amnezia VPN Panel"
SESSION_NAME=amnezia_panel_session
# Base64-encoded 32-byte key for encrypting server SSH secrets.
# Generate with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
APP_ENCRYPTION_KEY=
# Set to 1 when the panel is served over HTTPS, including behind a reverse proxy.
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
# Set to 1 only when the panel is behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=0
# Public self-registration is disabled by default.
ALLOW_REGISTRATION=0
# Enables development-only debug routes when set to 1/true/yes/on.
ENABLE_DEBUG_ROUTES=0
# Protect session-backed mutating requests with CSRF tokens.
AMNEZIA_CSRF_ENABLED=1

# Default locale
DEFAULT_LOCALE=en

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_DATABASE=amnezia_panel
DB_USERNAME=amnezia
DB_PASSWORD=amnezia
DB_ROOT_PASSWORD=rootpassword

# Admin Account (auto-created on first run)
ADMIN_EMAIL=admin@amnez.ia
ADMIN_PASSWORD=admin123

# API Configuration
JWT_SECRET=change_this_to_random_secret_key_for_production
API_RATE_LIMIT=100
# Failed login/API token attempts allowed per IP+email inside the window.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
API_TOKEN_RATE_LIMIT_ATTEMPTS=10
API_TOKEN_RATE_LIMIT_WINDOW_SECONDS=300

# VPN Defaults
DEFAULT_VPN_PORT_MIN=30000
DEFAULT_VPN_PORT_MAX=65000
DEFAULT_VPN_SUBNET=10.8.1.0/24
DEFAULT_DNS=1.1.1.1,1.0.0.1
# Maximum accepted uploaded backup/config/scenario file size in bytes.
AMNEZIA_UPLOAD_MAX_BYTES=20971520
# Optional extra backup library directories, separated by comma or semicolon.
BACKUP_LIBRARY_DIRS=

# VPN Client Performance / Diagnostics
# Log timing stages slower than this threshold in milliseconds.
AMNEZIA_TIMING_THRESHOLD_MS=300
# 0 disables periodic remote key sync; sync still runs when required server data is missing.
AMNEZIA_KEY_SYNC_TTL_SECONDS=0
# Set to 1 only if clients may be created outside the panel and IPs must be checked remotely.
AMNEZIA_STRICT_IP_SYNC=0
# Set to 1 to restore legacy wg-quick/awg-quick interface reload after each client add.
AMNEZIA_RELOAD_INTERFACE_ON_ADD=0

# Metrics collector
# How often the long-running collector starts a new collection cycle.
AMNEZIA_METRICS_INTERVAL_SECONDS=60
# Hard timeout for each SSH command issued by the metrics collector.
AMNEZIA_SSH_COMMAND_TIMEOUT_SECONDS=20
# How often AWG/WireGuard single-IP enforcement runs. Keep 0 unless you explicitly want to block roaming clients.
AMNEZIA_AWG_ENFORCEMENT_INTERVAL_SECONDS=0

# Alerts
# Server health notifications from the metrics collector.
ALERTS_ENABLED=0
ALERTS_FAILURE_THRESHOLD=2
ALERT_RESOURCE_FAILURE_THRESHOLD=5
ALERTS_COOLDOWN_SECONDS=1800
ALERT_CPU_WARNING_PERCENT=90
ALERT_CPU_CRITICAL_PERCENT=98
ALERT_RAM_WARNING_PERCENT=90
ALERT_RAM_CRITICAL_PERCENT=97
ALERT_DISK_WARNING_PERCENT=85
ALERT_DISK_CRITICAL_PERCENT=95
ALERT_WATCHDOG_RESTART_LOOKBACK_SECONDS=900
ALERT_HANDSHAKE_STALE_SECONDS=1800
ALERT_HANDSHAKE_STALE_PERCENT=70
ALERT_HANDSHAKE_MIN_PEERS=3

# Telegram alerts
TELEGRAM_ALERTS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts. If SMTP_HOST is empty, PHP mail() is used.
EMAIL_ALERTS_ENABLED=0
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Amnezia Panel"
SMTP_TLS=1

# Developer / smoke-test script variables (not used by the running panel)
# PANEL_URL=http://localhost:8082
# EMAIL=admin@amnez.ia
# PASSWORD=admin123
# TOKEN=
# SERVER_ID=1
# PROTOCOL_ID=
# UNINSTALL_SLUG=
# CLIENT_NAME=smoke-client
# CLIENT_LOGIN=smoke-client
# CLIENT_ID=
# DURATION=10
# OUT_FILE=
# OUT_DIR=scripts/_cycle_out
# SERVER_HOST=
# PROTOCOL_SLUG=amnezia-wg-advanced
# SELFTEST=1
# DIAGNOSE=1
# WG_PRIV_B64=
