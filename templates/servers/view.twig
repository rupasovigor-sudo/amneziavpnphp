{% extends "layout.twig" %}
{% block title %}{{ server.name }}{% endblock %}

{% block styles %}
<style>
.metric-mini {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
}
.metric-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
}
.metric-icon {
    width: 24px;
    text-align: center;
    font-size: 14px;
}
.metric-label {
    font-size: 0.75rem;
    color: #6b7280;
    min-width: 60px;
}
.metric-chart {
    height: 30px;
    flex: 1;
    min-width: 0;
}
.metric-value {
    font-size: 0.75rem;
    font-weight: 600;
    color: #111827;
    min-width: 70px;
    text-align: right;
}
</style>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
    <div>
      <h1 class="text-3xl font-bold flex items-center gap-2">
        <span id="serverNameText">{{ server.name }}</span>
        <button type="button" id="renameServerBtn" class="text-gray-400 hover:text-purple-600 text-base" title="Переименовать"><i class="fas fa-pen"></i></button>
      </h1>
      <div id="renameServerBox" class="mt-1 items-center gap-2" style="display:none">
        <input id="renameServerInput" type="text" maxlength="100" class="px-2 py-1 border rounded text-lg" value="{{ server.name }}">
        <button type="button" id="renameServerSave" class="px-2 py-1 bg-purple-600 text-white rounded text-sm">Сохранить</button>
        <button type="button" id="renameServerCancel" class="px-2 py-1 bg-gray-300 rounded text-sm">Отмена</button>
      </div>
      <p class="text-gray-600">{{ server.host }}</p>
    </div>
    <script>
    (function() {
      var SID_R = {{ server.id }};
      var btn = document.getElementById('renameServerBtn'),
          box = document.getElementById('renameServerBox'),
          txt = document.getElementById('serverNameText'),
          inp = document.getElementById('renameServerInput'),
          save = document.getElementById('renameServerSave'),
          cancel = document.getElementById('renameServerCancel');
      if (!btn) return;
      function show(on) { box.style.display = on ? 'flex' : 'none'; if (on) { inp.value = txt.textContent.trim(); inp.focus(); } }
      btn.addEventListener('click', function() { show(true); });
      cancel.addEventListener('click', function() { show(false); });
      save.addEventListener('click', function() {
        var name = inp.value.trim();
        if (!name) return;
        save.disabled = true;
        fetch('/servers/' + SID_R + '/rename', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ name: name }) })
          .then(function(r){ return r.json(); }).then(function(d){
            if (d.success) { txt.textContent = d.name; show(false); if (window.showToast) showToast('Сервер переименован', 'success'); }
            else if (window.showToast) showToast(d.error || 'Ошибка', 'error');
          }).catch(function(e){ if (window.showToast) showToast('Ошибка: ' + e, 'error'); })
          .finally(function(){ save.disabled = false; });
      });
      inp.addEventListener('keydown', function(e){ if (e.key === 'Enter') save.click(); if (e.key === 'Escape') show(false); });
    })();
    </script>
    <a href="/servers/{{ server.id }}/monitoring" class="inline-flex items-center justify-center px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 text-sm font-medium">
      <i class="fas fa-chart-line mr-2"></i>Мониторинг
    </a>
  </div>

      <div class="bg-white rounded shadow p-6 mb-8">
      <div class="p-3 border rounded-lg bg-gray-50">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-semibold text-gray-700"><i class="fas fa-globe mr-1 text-purple-600"></i>Домен и пул серверов</span>
          <span id="poolBadge" class="px-2 py-0.5 rounded text-sm bg-gray-200 text-gray-600">…</span>
        </div>
        <div class="mb-2 flex items-center gap-2">
          <span class="text-sm text-gray-600"><i class="fas fa-signal mr-1 text-purple-600"></i>Живые клиенты:</span>
          <span id="liveClientsVal" class="text-sm text-gray-500">…</span>
          <button id="liveRefreshBtn" class="px-2 py-0.5 rounded text-sm bg-slate-500 text-white" title="Обновить — показывает пиров с недавним рукопожатием (реальный трафик, доказывает, что сервер принимает клиентов)"><i class="fas fa-rotate"></i></button>
        </div>

        {# Standalone (not in a pool): manage the domain + optionally create a pool #}
        <div id="standaloneBox" style="display:none">
          <div class="flex items-center gap-2">
            <input id="dnsDomainInput" value="{{ server.domain ?? '' }}" placeholder="awg.gptanalitika.com"
                   class="flex-1 px-2 py-1 border rounded text-sm font-mono">
            <button id="dnsSaveBtn" class="px-3 py-1 bg-purple-600 text-white rounded text-sm">Сохранить</button>
            <button id="dnsRepointBtn" class="px-3 py-1 bg-blue-600 text-white rounded text-sm" title="Создать/обновить A-запись через DNS API">A → сюда</button>
          </div>
          <div class="mt-2 flex items-center gap-2 flex-wrap">
            <button id="poolCreateBtn" class="px-3 py-1 bg-indigo-600 text-white rounded text-sm">
              <i class="fas fa-layer-group mr-1"></i>Создать пул из этого сервера
            </button>
            <span id="poolJoinBox" class="inline-flex items-center gap-2" style="display:none">
              <span class="text-sm text-gray-400">или</span>
              <select id="poolJoinSelect" class="px-2 py-1 border rounded text-sm"></select>
              <button id="poolJoinBtn" class="px-3 py-1 bg-teal-600 text-white rounded text-sm">Добавить в пул</button>
            </span>
          </div>
          <p id="standaloneMsg" class="mt-2 text-sm text-gray-500 leading-tight">
            Пул объединяет несколько серверов под одним доменом с общей идентичностью awg2. Клиенты подключаются к <code>domain:443</code>; при недоступности активного сервера домен переключается на резервный без смены конфига. При добавлении в существующий пул сервер передеплоится с общими ключами (~2 мин) и станет резервным (STANDBY).
          </p>
        </div>

        {# In a pool: show members, roles, and controls #}
        <div id="poolBox" style="display:none">
          <div class="text-sm text-gray-600 mb-2">
            Пул <b id="poolName"></b> · домен <code id="poolDomain"></code> · клиенты → <code id="poolEndpoint"></code>
            <button type="button" id="poolEditBtn" class="ml-1 text-gray-400 hover:text-purple-600" title="Изменить имя/домен пула"><i class="fas fa-pen text-sm"></i></button>
          </div>
          <div id="poolEditBox" class="mb-2 p-2 bg-gray-50 rounded text-sm" style="display:none">
            <div class="flex flex-wrap items-center gap-2">
              <label>Имя: <input id="poolNameInput" type="text" maxlength="100" class="px-2 py-0.5 border rounded"></label>
              <label>Домен: <input id="poolDomainInput" type="text" maxlength="253" class="px-2 py-0.5 border rounded" placeholder="awg.example.com"></label>
              <label class="inline-flex items-center gap-1"><input id="poolRepointChk" type="checkbox" checked> репойнт нового домена на активный</label>
              <button type="button" id="poolEditSave" class="px-2 py-0.5 bg-purple-600 text-white rounded">Сохранить</button>
              <button type="button" id="poolEditCancel" class="px-2 py-0.5 bg-gray-300 rounded">Отмена</button>
            </div>
            <p class="mt-1 text-sm text-amber-700">⚠ Смена домена: клиентские конфиги ведут на старый домен — их нужно перевыпустить. Пустое поле не меняется.</p>
          </div>
          <div id="poolMembers" class="space-y-1"></div>
          <p id="poolMsg" class="mt-2 text-sm text-gray-500 leading-tight">
            Конфиг клиента <b>единый для всего пула</b> (домен + общие ключи) и синхронизируется на все серверы автоматически — неважно, на каком сервере создавать клиента. <b>ACTIVE</b> — сюда указывает домен и идут клиенты; <b>STANDBY</b> — синхронизирован и готов к переключению.
          </p>
          <div class="mt-2 pt-2 border-t">
            <details>
              <summary class="text-sm text-gray-700 cursor-pointer"><i class="fas fa-route mr-1"></i>AllowedIPs для роутера (full-tunnel, исключает все IP пула)</summary>
              <div class="mt-2 space-y-2">
                <p class="text-sm text-gray-500 leading-tight">Для full-tunnel конфига (напр. MikroTik), который не должен заворачивать endpoint обратно в туннель. Вычитает из <code>0.0.0.0/0</code> <b>все ingress-IP пула</b> + локальные исключения ниже — конфиг переживает failover без правок. <b>Перегенерируй при добавлении нового сервера в пул.</b></p>
                <label class="block text-sm text-gray-600">Локальные исключения — по одному CIDR в строке (свой адрес, LAN, docker-сети):</label>
                <textarea id="aipExtra" rows="3" class="w-full border rounded px-2 py-1 text-sm font-mono" placeholder="10.8.1.8/32&#10;172.18.20.0/30"></textarea>
                <button type="button" id="aipGenBtn" class="px-2 py-1 bg-slate-700 text-white rounded text-sm"><i class="fas fa-gears mr-1"></i>Сгенерировать</button>
                <div id="aipOut" style="display:none">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-sm text-gray-500">Замени строку <code>AllowedIPs = …</code> в секции <code>[Peer]</code> конфига роутера:</span>
                    <button type="button" id="aipCopy" class="px-2 py-0.5 bg-gray-200 rounded text-sm">Копировать</button>
                  </div>
                  <textarea id="aipResult" rows="4" readonly class="w-full border rounded px-2 py-1 text-sm font-mono bg-gray-50"></textarea>
                  <p id="aipMeta" class="text-sm text-gray-400 mt-1"></p>
                </div>
              </div>
            </details>
          </div>
          <div class="mt-2 pt-2 border-t">
            <button type="button" id="poolDeleteBtn" class="px-2 py-1 bg-red-600 text-white rounded text-sm"><i class="fas fa-trash mr-1"></i>Удалить пул</button>
            <span class="text-sm text-gray-400 ml-1">распустит членов (станут standalone) и удалит DNS-запись домена</span>
          </div>
        </div>
      </div>
      </div>
      <script>
      (function () {
        const SID = {{ server.id }};
        const badge = document.getElementById('poolBadge');
        const standalone = document.getElementById('standaloneBox');
        const poolBox = document.getElementById('poolBox');
        const setBadge = (t, c) => { badge.textContent = t; badge.className = 'px-2 py-0.5 rounded text-sm ' + c; };
        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));

        function renderPool(d) {
          standalone.style.display = 'none';
          poolBox.style.display = 'block';
          document.getElementById('poolName').textContent = d.pool.name;
          document.getElementById('poolDomain').textContent = d.pool.domain || '(не задан)';
          document.getElementById('poolEndpoint').textContent = (d.pool.domain || '?') + ':' + (d.pool.vpn_port || 443);
          const activeUp = (d.members.find(m => m.role === 'active') || {}).dns_points_here;
          setBadge(activeUp ? 'домен → активный' : 'домен ≠ активный', activeUp ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700');
          const rows = d.members.map(m => {
            const roleBadge = m.role === 'active'
              ? '<span class="px-1.5 py-0.5 rounded text-sm bg-green-100 text-green-700">ACTIVE</span>'
              : '<span class="px-1.5 py-0.5 rounded text-sm bg-gray-200 text-gray-600">STANDBY</span>';
            const dnsMark = m.dns_points_here ? '<span title="домен указывает сюда" class="text-green-600">◉</span>' : '<span class="text-gray-300">◯</span>';
            const here = m.id === SID ? ' <span class="text-sm text-purple-600">(этот)</span>' : '';
            const syncBadge = m.sync_pending
              ? '<span title="часть клиентских пиров не синхронизирована — исключён из failover" class="px-1.5 py-0.5 rounded text-sm bg-yellow-100 text-yellow-800"><i class="fas fa-triangle-exclamation"></i> рассинхрон</span>'
              : '';
            const probedOk = m.validated_clean === null && m.validation_note && m.validation_note.indexOf('reachable') !== -1;
            const valBadge = m.validated_clean === 0
              ? `<span title="${esc(m.validation_note || 'пробник: недоступен')}" class="px-1.5 py-0.5 rounded text-sm bg-red-100 text-red-700"><i class="fas fa-xmark"></i> тест не пройден</span>`
              : (m.validated_clean === 1
                  ? `<span title="${esc(m.validation_note || 'проверен канарейкой (чистый)')}" class="px-1.5 py-0.5 rounded text-sm bg-green-100 text-green-700"><i class="fas fa-check"></i> чистый</span>`
                  : (probedOk
                      ? `<span title="${esc(m.validation_note)} — инфра доступна; чистоту для цензурируемых сетей подтвердит канарейка" class="px-1.5 py-0.5 rounded text-sm bg-sky-100 text-sky-700"><i class="fas fa-plug"></i> инфра ок</span>`
                      : `<span title="ещё не проверялся handshake-пробником" class="px-1.5 py-0.5 rounded text-sm bg-gray-100 text-gray-500">не проверен</span>`));
            const dnsMismatch = (m.dns_points_here && m.role !== 'active')
              ? `<span title="домен резолвится сюда, но активным в пуле числится другой сервер — рассинхрон DNS↔пул" class="px-1.5 py-0.5 rounded text-sm bg-orange-100 text-orange-800"><i class="fas fa-triangle-exclamation"></i> домен ведёт сюда (не активный)</span>`
              : ((!m.dns_points_here && m.role === 'active')
                  ? `<span title="числится активным, но домен резолвится не сюда" class="px-1.5 py-0.5 rounded text-sm bg-orange-100 text-orange-800"><i class="fas fa-triangle-exclamation"></i> активный, но домен не здесь</span>`
                  : '');
            const act = [
              m.role !== 'active' ? `<button data-probe="${m.id}" class="px-2 py-0.5 rounded text-sm bg-indigo-600 text-white" title="Handshake-пробник с активного сервера: проверяет, что ingress жив/проброшен (не проверяет прожиг)">Проверить</button>` : '',
              m.role !== 'active' ? `<button data-activate="${m.id}" class="px-2 py-0.5 rounded text-sm bg-blue-600 text-white">Сделать активным</button>` : '',
              m.sync_pending ? `<button data-resync="${m.id}" class="px-2 py-0.5 rounded text-sm bg-yellow-600 text-white">Ре-синк</button>` : '',
              (m.validated_clean === 1
                ? `<button data-markclean="0" data-mid="${m.id}" class="px-2 py-0.5 rounded text-sm bg-gray-400 text-white" title="Снять пометку годности">Снять годность</button>`
                : `<button data-markclean="1" data-mid="${m.id}" class="px-2 py-0.5 rounded text-sm bg-green-600 text-white" title="Пометить проверенным — станет доступен для авто-failover">Пометить годным</button>`),
            ].join(' ');
            return `<div class="flex items-center justify-between border rounded px-2 py-1 bg-white">
              <div class="text-sm">${dnsMark} <b>${esc(m.name)}</b>${here} <span class="text-gray-400 font-mono">${esc(m.host)}</span> ${roleBadge} ${syncBadge} ${valBadge} <span class="text-sm text-gray-400">pri ${m.priority}·${esc(m.status)}</span></div>
              <div class="flex gap-1">${act}</div>
            </div>`;
          }).join('');
          document.getElementById('poolMembers').innerHTML = rows;
          poolBox.querySelectorAll('[data-activate]').forEach(b => b.addEventListener('click', () => activate(b.getAttribute('data-activate'), b)));
          poolBox.querySelectorAll('[data-resync]').forEach(b => b.addEventListener('click', () => resyncMember(b.getAttribute('data-resync'), b)));
          poolBox.querySelectorAll('[data-markclean]').forEach(b => b.addEventListener('click', () => markClean(b.getAttribute('data-mid'), b.getAttribute('data-markclean') === '1', b)));
          poolBox.querySelectorAll('[data-probe]').forEach(b => b.addEventListener('click', () => probeMember(b.getAttribute('data-probe'), b)));
        }

        function renderStandalone(d) {
          poolBox.style.display = 'none';
          standalone.style.display = 'block';
          setBadge('без пула', 'bg-gray-200 text-gray-600');
          const box = document.getElementById('poolJoinBox');
          const sel = document.getElementById('poolJoinSelect');
          const pools = (d && d.available_pools) || [];
          if (box && sel) {
            if (pools.length) {
              sel.innerHTML = pools.map(p => `<option value="${p.id}">${esc(p.name)}${p.domain ? ' (' + esc(p.domain) + ')' : ''}</option>`).join('');
              box.style.display = 'inline-flex';
            } else {
              box.style.display = 'none';
            }
          }
        }

        function load() {
          fetch('/servers/' + SID + '/pool/status').then(r => r.json()).then(d => {
            if (!d.success) { setBadge('ошибка', 'bg-red-100 text-red-700'); return; }
            if (d.in_pool) renderPool(d); else renderStandalone(d);
          }).catch(() => setBadge('ошибка', 'bg-red-100 text-red-700'));
        }

        function activate(memberId, btn) {
          if (btn) { btn.disabled = true; btn.textContent = '…'; }
          fetch('/servers/' + memberId + '/pool/activate', { method: 'POST', headers: {'Content-Type':'application/json'}, body: '{}' })
            .then(r => r.json()).then(d => {
              document.getElementById('poolMsg').textContent = d.message || (d.dns && d.dns.message) || (d.success ? 'Переключено' : (d.error || 'Ошибка'));
              load();
            }).catch(e => { document.getElementById('poolMsg').textContent = 'Ошибка: ' + e; load(); });
        }

        function probeMember(memberId, btn) {
          if (btn) { btn.disabled = true; btn.textContent = '…'; }
          document.getElementById('poolMsg').textContent = 'Пробник доступности (handshake с активного сервера, до ~30с)…';
          fetch('/servers/' + memberId + '/pool/probe', { method: 'POST', headers: {'Content-Type':'application/json'}, body: '{}' })
            .then(r => r.json()).then(d => {
              const ok = d.success && d.reachable;
              showToast(d.message || (d.success ? (d.reachable ? 'Доступен' : 'Недоступен') : (d.error || 'Ошибка')), ok ? 'success' : 'error');
              load();
            }).catch(e => { showToast('Ошибка: ' + e, 'error'); load(); });
        }

        function markClean(memberId, clean, btn) {
          if (btn) { btn.disabled = true; btn.textContent = '…'; }
          fetch('/servers/' + memberId + '/pool/mark-clean', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ clean: clean }) })
            .then(r => r.json()).then(d => { showToast(d.message || (d.success ? 'Готово' : (d.error || 'Ошибка')), d.success ? 'success' : 'error'); load(); })
            .catch(e => { showToast('Ошибка: ' + e, 'error'); load(); });
        }

        function resyncMember(memberId, btn) {
          if (btn) { btn.disabled = true; btn.textContent = '…'; }
          document.getElementById('poolMsg').textContent = 'Ре-синк клиентских пиров (может занять до минуты)…';
          fetch('/servers/' + memberId + '/pool/resync', { method: 'POST', headers: {'Content-Type':'application/json'}, body: '{}' })
            .then(r => r.json()).then(d => { showToast(d.message || (d.success ? 'Синхронизировано' : (d.error || 'Ошибка')), d.success ? 'success' : 'error'); load(); })
            .catch(e => { showToast('Ошибка: ' + e, 'error'); load(); });
        }

        // Standalone domain actions
        function dnsUpdate(payload) {
          fetch('/servers/' + SID + '/dns/update', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) })
            .then(r => r.json()).then(() => load()).catch(() => load());
        }
        const saveBtn = document.getElementById('dnsSaveBtn');
        const repointBtn = document.getElementById('dnsRepointBtn');
        const createBtn = document.getElementById('poolCreateBtn');
        const domInput = document.getElementById('dnsDomainInput');
        if (saveBtn) saveBtn.addEventListener('click', () => dnsUpdate({ domain: domInput.value.trim() }));
        if (repointBtn) repointBtn.addEventListener('click', () => dnsUpdate({ domain: domInput.value.trim(), upsert: true }));
        if (createBtn) createBtn.addEventListener('click', () => {
          const name = prompt('Название пула:', 'pool-' + SID);
          if (!name) return;
          createBtn.disabled = true; createBtn.textContent = '…';
          fetch('/servers/' + SID + '/pool/create', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ name }) })
            .then(r => r.json()).then(d => { showToast(d.message || (d.success ? 'Пул создан' : d.error), d.success ? 'success' : 'error'); load(); })
            .catch(e => { showToast('Ошибка: ' + e, 'error'); load(); });
        });

        function fmtAge(sec) {
          if (sec == null) return 'никогда';
          if (sec < 60) return sec + 'с назад';
          if (sec < 3600) return Math.floor(sec / 60) + 'м назад';
          return Math.floor(sec / 3600) + 'ч назад';
        }
        function loadLiveClients() {
          const val = document.getElementById('liveClientsVal');
          if (!val) return;
          val.textContent = '…'; val.className = 'text-sm text-gray-500';
          fetch('/servers/' + SID + '/net/live-clients').then(r => r.json()).then(d => {
            if (!d.success) { val.textContent = d.error || 'ошибка'; val.className = 'text-sm text-red-600'; return; }
            val.textContent = d.active_peers + ' активных / ' + d.total_peers + ' всего · рукопожатие ' + fmtAge(d.last_handshake_age);
            val.className = 'text-sm ' + (d.active_peers > 0 ? 'text-green-600' : (d.total_peers > 0 ? 'text-amber-600' : 'text-gray-500'));
          }).catch(e => { val.textContent = 'ошибка: ' + e; val.className = 'text-sm text-red-600'; });
        }
        const liveBtn = document.getElementById('liveRefreshBtn');
        if (liveBtn) liveBtn.addEventListener('click', loadLiveClients);
        loadLiveClients();

        function resetJoinBtn() {
          const jb = document.getElementById('poolJoinBtn');
          if (jb) { jb.disabled = false; jb.textContent = 'Добавить в пул'; }
        }
        function setJoinDeploying(msg) {
          const jb = document.getElementById('poolJoinBtn');
          if (jb) { jb.disabled = true; jb.textContent = 'Разворачивается…'; }
          const m = document.getElementById('standaloneMsg');
          if (m) m.textContent = (msg || 'Добавление в пул идёт в фоне') + ' — можно закрыть страницу, прогресс сохранится.';
        }
        let joinPollTimer = null;
        // Poll the background join worker; resumes automatically on page load if a
        // join is still in flight (state lives in the DB, survives a reload).
        function pollJoinStatus(resume) {
          fetch('/servers/' + SID + '/join-status').then(r => r.json()).then(d => {
            if (!d.success) return;
            if (d.state === 'deploying') {
              setJoinDeploying(d.message);
              clearTimeout(joinPollTimer);
              joinPollTimer = setTimeout(() => pollJoinStatus(true), 5000);
            } else if (d.state === 'done') {
              showToast(d.message || 'Сервер добавлен в пул', 'success');
              resetJoinBtn(); load();
            } else if (d.state === 'failed') {
              showToast(d.message || 'Не удалось добавить в пул', 'error');
              resetJoinBtn();
              const m = document.getElementById('standaloneMsg');
              if (m) m.textContent = 'Ошибка добавления: ' + (d.message || '') + '. Можно повторить.';
            } else if (resume && d.in_pool) {
              load();
            }
          }).catch(() => {});
        }

        const joinBtn = document.getElementById('poolJoinBtn');
        if (joinBtn) joinBtn.addEventListener('click', async () => {
          const sel = document.getElementById('poolJoinSelect');
          const poolId = sel && sel.value;
          if (!poolId) return;
          if (!(await showConfirmModal('Сервер будет передеплоен с общими ключами пула и WARP-egress (в фоне, ~5-7 мин) и станет резервным (STANDBY). Текущая awg2-идентичность и клиенты этого сервера будут заменены на общие. Можно закрыть страницу — добавление продолжится.', 'Добавить сервер в пул?', 'Добавить'))) return;
          setJoinDeploying('Запуск добавления в пул…');
          fetch('/servers/' + SID + '/pool/join', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ pool_id: Number(poolId) }) })
            .then(r => r.json()).then(d => {
              if (d.success) { showToast(d.message || 'Запущено в фоне', 'success'); window.location.href = '/servers'; }
              else { showToast(d.error || 'Ошибка', 'error'); resetJoinBtn(); }
            })
            .catch(e => { showToast('Ошибка: ' + e, 'error'); resetJoinBtn(); });
        });

        // Pool edit: name + shared domain.
        const poolEditBtn = document.getElementById('poolEditBtn');
        if (poolEditBtn) poolEditBtn.addEventListener('click', function () {
          document.getElementById('poolNameInput').value = (document.getElementById('poolName').textContent || '').trim();
          const dom = (document.getElementById('poolDomain').textContent || '').trim();
          document.getElementById('poolDomainInput').value = (dom === '(не задан)') ? '' : dom;
          document.getElementById('poolEditBox').style.display = 'block';
        });
        const poolEditCancel = document.getElementById('poolEditCancel');
        if (poolEditCancel) poolEditCancel.addEventListener('click', function () {
          document.getElementById('poolEditBox').style.display = 'none';
        });
        const poolEditSave = document.getElementById('poolEditSave');
        if (poolEditSave) poolEditSave.addEventListener('click', function () {
          const body = {};
          const nm = document.getElementById('poolNameInput').value.trim();
          const dm = document.getElementById('poolDomainInput').value.trim();
          if (nm) body.name = nm;
          if (dm) { body.domain = dm; body.repoint = document.getElementById('poolRepointChk').checked; }
          if (!body.name && !body.domain) { showToast('Нечего сохранять (пустые поля не меняются)', 'error'); return; }
          poolEditSave.disabled = true;
          fetch('/servers/' + SID + '/pool/update', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) })
            .then(r => r.json()).then(d => {
              if (d.success) {
                showToast(d.warning || 'Пул обновлён', d.warning ? 'info' : 'success');
                document.getElementById('poolEditBox').style.display = 'none';
                load();
              } else { showToast(d.error || 'Ошибка', 'error'); }
            }).catch(e => showToast('Ошибка: ' + e, 'error'))
            .finally(() => { poolEditSave.disabled = false; });
        });

        const poolDeleteBtn = document.getElementById('poolDeleteBtn');
        if (poolDeleteBtn) poolDeleteBtn.addEventListener('click', async function () {
          const dom = (document.getElementById('poolDomain').textContent || '').trim();
          const domTxt = (dom && dom !== '(не задан)') ? (' и удалит DNS-запись ' + dom) : '';
          const ok = await showConfirmModal(
            'Пул будет распущен и удалён. Серверы станут standalone (awg2-контейнеры и клиенты сохранятся)' + domTxt + '. Продолжить?',
            'Удалить пул?', 'Удалить');
          if (!ok) return;
          poolDeleteBtn.disabled = true;
          fetch('/servers/' + SID + '/pool/delete', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ remove_dns: true }) })
            .then(r => r.json()).then(d => {
              showToast(d.message || (d.success ? 'Пул удалён' : (d.error || 'Ошибка')), d.success ? 'success' : 'error');
              load();
            }).catch(e => showToast('Ошибка: ' + e, 'error'))
            .finally(() => { poolDeleteBtn.disabled = false; });
        });

        const aipGenBtn = document.getElementById('aipGenBtn');
        if (aipGenBtn) aipGenBtn.addEventListener('click', function () {
          const extra = (document.getElementById('aipExtra').value || '').trim();
          aipGenBtn.disabled = true;
          fetch('/servers/' + SID + '/pool/allowed-ips?exclude=' + encodeURIComponent(extra))
            .then(r => r.json()).then(d => {
              if (!d.success) { showToast(d.error || 'Ошибка', 'error'); return; }
              document.getElementById('aipResult').value = 'AllowedIPs = ' + d.allowed_ips;
              document.getElementById('aipMeta').textContent =
                'IP пула исключено: ' + (d.member_ips || []).length +
                ' (' + (d.member_ips || []).join(', ') + '); всего исключений: ' + (d.excluded || []).length;
              document.getElementById('aipOut').style.display = 'block';
            }).catch(e => showToast('Ошибка: ' + e, 'error'))
            .finally(() => { aipGenBtn.disabled = false; });
        });
        const aipCopy = document.getElementById('aipCopy');
        if (aipCopy) aipCopy.addEventListener('click', function () {
          const ta = document.getElementById('aipResult');
          ta.select();
          navigator.clipboard.writeText(ta.value).then(() => showToast('Скопировано', 'success'))
            .catch(() => { document.execCommand('copy'); showToast('Скопировано', 'success'); });
        });

        load();
        pollJoinStatus(true);
      })();
      </script>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded shadow p-6">
      <h3 class="font-bold mb-4">{{ t('servers.server_info') }}</h3>
      <dl class="space-y-2">
        <div><dt class="text-sm text-gray-600">{{ t('common.status') }}</dt><dd><span class="px-2 py-1 bg-green-100 text-green-800 rounded text-sm">{{ server.status }}</span></dd></div>
        {% if server_protocols|length <= 1 %}
        <div><dt class="text-sm text-gray-600">VPN Port</dt><dd>{{ server.vpn_port }}</dd></div>
        <div><dt class="text-sm text-gray-600">Subnet</dt><dd>{{ server.vpn_subnet }}</dd></div>
        {% endif %}

      </dl>

      {# ── Package updates ── #}
      <div class="mt-4 p-3 border rounded-lg bg-gray-50" id="updBox">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-semibold text-gray-700"><i class="fas fa-box mr-1 text-purple-600"></i>Обновления пакетов</span>
          <span id="updBadge" class="px-2 py-0.5 rounded text-sm bg-gray-200 text-gray-600">…</span>
        </div>
        <dl id="updInfo" class="text-sm text-gray-600 space-y-1"></dl>
        <p id="updStamp" class="mt-1 text-sm text-gray-400"></p>
        <p id="updMsg" class="mt-2 text-sm text-gray-500 leading-tight"></p>
        <div class="mt-2 flex items-center gap-2 flex-wrap">
          <button type="button" id="updRefreshBtn" class="px-3 py-1 bg-slate-600 text-white rounded text-sm"><i class="fas fa-rotate mr-1"></i>Проверить</button>
          <button type="button" class="js-upd-act px-3 py-1 bg-purple-600 text-white rounded text-sm" data-action="os"><i class="fas fa-download mr-1"></i>Пакеты ОС</button>
          <button type="button" class="js-upd-act px-3 py-1 bg-orange-600 text-white rounded text-sm" data-action="kernel" title="full-upgrade: ставит пакеты, требующие новых зависимостей (ядро)"><i class="fas fa-microchip mr-1"></i>Ядро</button>
          <button type="button" class="js-upd-act px-3 py-1 bg-amber-600 text-white rounded text-sm" data-action="docker" title="Перезапускает docker-демон — туннели на этом сервере кратко порвутся"><i class="fab fa-docker mr-1"></i>Docker</button>
          <button type="button" class="js-upd-act px-3 py-1 bg-teal-700 text-white rounded text-sm" data-action="awg2" title="Пересборка из upstream с сохранением идентичности пула"><i class="fas fa-hammer mr-1"></i>awg2</button>
          <button type="button" class="js-upd-act px-3 py-1 bg-sky-700 text-white rounded text-sm" data-action="warp"><i class="fas fa-cloud mr-1"></i>WARP</button>
          <button type="button" class="js-upd-act px-3 py-1 bg-red-700 text-white rounded text-sm" data-action="reboot"><i class="fas fa-power-off mr-1"></i>Перезагрузить</button>
        </div>
        <p class="mt-2 text-sm text-gray-400 leading-tight">Docker и containerd на время обновления <b>удерживаются</b> — их апгрейд перезапускает демон и рвёт туннели, это отдельная операция. Перезагрузка автоматически не делается.</p>
        <details id="updHistBox" class="mt-2" style="display:none">
          <summary class="text-sm text-gray-600 cursor-pointer">История операций</summary>
          <div id="updHist" class="mt-1 space-y-1 text-sm"></div>
        </details>
      </div>
      <script>
      (function () {
        const SID = {{ server.id }};
        const badge = document.getElementById('updBadge');
        const info = document.getElementById('updInfo');
        const msg = document.getElementById('updMsg');
        const refreshBtn = document.getElementById('updRefreshBtn');
        const actBtns = () => document.querySelectorAll('.js-upd-act');
        const stamp = document.getElementById('updStamp');
        let poll = null;

        const setBadge = (t, c) => { badge.textContent = t; badge.className = 'px-2 py-0.5 rounded text-sm ' + c; };
        const row = (k, v) => `<div class="flex justify-between gap-2"><dt>${k}</dt><dd class="font-medium text-gray-800">${v}</dd></div>`;

        function render(d) {
          const a = d.audit || {};
          if (!a || a.ok === false) { setBadge('нет данных', 'bg-gray-200 text-gray-600'); return; }
          const up = (a.actionable != null ? a.actionable : (a.upgradable || 0));
          const phased = a.phased || 0;
          const stale = [];
          if (a.awg2_update_available === true) stale.push('awg2');
          if (a.warp_update_available === true) stale.push('WARP');
          if (up === 0 && !stale.length) setBadge('всё актуально', 'bg-green-100 text-green-700');
          else if (a.security > 0) setBadge(up + ' обновлений · ' + a.security + ' security', 'bg-red-100 text-red-700');
          else if (up > 0) setBadge(up + ' обновлений' + (stale.length ? ' · ' + stale.join('/') : ''), 'bg-yellow-100 text-yellow-800');
          else setBadge('обновить: ' + stale.join('/'), 'bg-yellow-100 text-yellow-800');

          let html = row('Пакетов к обновлению', up + (a.security ? ` <span class="text-red-600">(security: ${a.security})</span>` : ''));
          if (phased) html += row('Отложены Ubuntu', `<span class="text-gray-500">${phased} (phased rollout — придут сами)</span>`);
          if (a.kernel_upgradable) html += row('Ядро', `<span class="text-amber-700">${a.kernel_upgradable} — нужен full-upgrade («Ядро»)</span>`);
          if (a.docker_upgradable) html += row('Из них Docker/containerd', `<span class="text-amber-700">${a.docker_upgradable} (удерживаются)</span>`);
          if (a.reboot_required) html += row('Перезагрузка', '<span class="text-red-600">требуется</span>');
          html += row('Ядро', a.kernel || '—');
          html += row('Docker', a.docker_version || '—');
          html += row('Образ awg2', (a.awg2_image_created || '—').replace('T', ' '));
          html += row('awg2 / WARP', (a.awg2_running ? '✅' : '❌') + ' / ' + (a.warp_active ? '✅' : '❌'));
          // Version freshness (null = could not determine, e.g. no GitHub access)
          const verdict = (flag, okTxt, oldTxt) => flag == null
            ? '<span class="text-gray-400">не определено</span>'
            : (flag ? `<span class="text-yellow-700">${oldTxt}</span>` : `<span class="text-green-700">${okTxt}</span>`);
          html += row('Версия awg2', verdict(a.awg2_update_available, 'актуальна', 'есть обновление')
            + (a.awg2_src_date ? ` <span class="text-gray-400">(${a.awg2_src_date})</span>` : ''));
          html += row('Скрипты WARP', verdict(a.warp_update_available, 'актуальны', 'отличаются от репозитория'));
          if (a.lists_age_h != null) html += row('Списки пакетов', a.lists_age_h + ' ч назад');
          info.innerHTML = html;

          // The active member carries live clients — updating it is gated.
          if (d.is_active) {
            // Active member: keep the buttons clickable but flag the risk —
            // the server confirms with a 409 + explicit force prompt anyway.
            actBtns().forEach(b => {
              b.classList.add('ring-2', 'ring-red-400');
              b.title = 'Активный член пула — потребуется явное подтверждение';
            });
          }
        }

        const ACT_NAMES = { os: 'Пакеты ОС', kernel: 'Ядро', docker: 'Docker', awg2: 'awg2', warp: 'WARP', reboot: 'Перезагрузка' };
        function renderHistory(rows) {
          const box = document.getElementById('updHistBox');
          const list = document.getElementById('updHist');
          if (!rows || !rows.length) { box.style.display = 'none'; return; }
          box.style.display = 'block';
          list.innerHTML = rows.map(r => {
            const ok = r.state === 'done';
            const icon = ok ? '<span class="text-green-700">✅</span>' : '<span class="text-red-700">❌</span>';
            const forced = Number(r.forced) ? ' <span class="text-red-600" title="выполнено принудительно на активном сервере">⚠force</span>' : '';
            const when = (r.finished_at || '').replace('T', ' ');
            return `<div class="border-l-2 ${ok ? 'border-green-300' : 'border-red-300'} pl-2">
              ${icon} <b>${ACT_NAMES[r.action] || r.action}</b>${forced}
              <span class="text-gray-400">${when}</span>
              <div class="text-gray-600">${(r.message || '').replace(/</g, '&lt;')}</div>
            </div>`;
          }).join('');
        }

        function showState(st) {
          if (!st || !st.state) return;
          if (st.state === 'running') {
            msg.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-1"></i>' + (st.message || 'Обновление идёт…');
            actBtns().forEach(b => b.disabled = true);
            startPoll();
          } else if (st.state === 'done') {
            msg.innerHTML = '<span class="text-green-700">✅ ' + (st.message || 'Готово') + '</span>';
          } else if (st.state === 'failed') {
            msg.innerHTML = '<span class="text-red-700">❌ ' + (st.message || 'Ошибка') + '</span>';
          }
        }

        function load(refresh) {
          const orig = refreshBtn.innerHTML;
          refreshBtn.disabled = true;
          if (refresh) refreshBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-1"></i>Проверяю…';
          fetch('/servers/' + SID + '/updates/audit' + (refresh ? '?refresh=1' : ''), { credentials: 'same-origin' })
            .then(async r => {
              // Never swallow failures silently: a dead-looking button is worse
              // than an error message.
              const text = await r.text();
              if (!r.ok) throw new Error('HTTP ' + r.status);
              try { return JSON.parse(text); }
              catch (e) { throw new Error('некорректный ответ сервера'); }
            })
            .then(d => {
              if (d.success === false) throw new Error(d.error || 'аудит не удался');
              render(d);
              showState(d.state);
              renderHistory(d.history);
              // Always give visible proof the click did something, even when the
              // numbers are unchanged.
              stamp.textContent = 'проверено в ' + new Date().toLocaleTimeString();
              if (refresh && window.showToast) showToast('Данные обновлены', 'success');
            })
            .catch(e => {
              stamp.textContent = 'ошибка проверки: ' + e.message;
              if (window.showToast) showToast('Проверка обновлений: ' + e.message, 'error');
            })
            .finally(() => { refreshBtn.disabled = false; refreshBtn.innerHTML = orig; });
        }

        function startPoll() {
          if (poll) return;
          poll = setInterval(() => {
            fetch('/servers/' + SID + '/updates/status').then(r => r.json()).then(d => {
              if (!d.success) return;
              const st = d.state || {};
              if (st.state !== 'running') {
                clearInterval(poll); poll = null;
                actBtns().forEach(b => b.disabled = false);
                showState(st);
                renderHistory(d.history);
                load(false);
                if (window.showToast) showToast(st.message || 'Обновление завершено', st.state === 'done' ? 'success' : 'error');
              } else {
                msg.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-1"></i>' + (st.message || 'Обновление идёт…');
              }
            }).catch(() => {});
          }, 5000);
        }

        // Each action states plainly what it costs, so nobody clicks "awg2" on a
        // production member expecting it to be free.
        const ACTIONS = {
          os:     { title: 'Обновить пакеты ОС?',   warn: 'Docker удерживается, простоя быть не должно. Если обновится ядро — потребуется перезагрузка.' },
          kernel: { title: 'Обновить ядро (full-upgrade)?', warn: 'Ставит пакеты, требующие новых зависимостей — обычно ядро. Docker остаётся удержанным. Новое ядро заработает только после перезагрузки, сама операция клиентов не рвёт.' },
          docker: { title: 'Обновить Docker?',      warn: 'Перезапустит docker-демон: контейнер awg2 уйдёт в ребут, туннели на этом сервере порвутся на несколько секунд.' },
          awg2:   { title: 'Пересобрать awg2?',     warn: 'Пересборка из upstream. Идентичность пула сохраняется (клиентские конфиги не сломаются), пиры восстанавливаются из БД. На время сборки сервер клиентов не обслуживает (несколько минут). Только для членов пула.' },
          warp:   { title: 'Переустановить WARP?',  warn: 'Egress через Cloudflare прервётся на время переустановки.' },
          reboot: { title: 'Перезагрузить сервер?', warn: 'Сервер уйдёт в перезагрузку. Контейнер и WARP подняты как autostart, ожидание возврата — до 5 минут.' },
        };

        function runAction(action, force) {
          const btns = document.querySelectorAll('.js-upd-act');
          btns.forEach(b => b.disabled = true);
          fetch('/servers/' + SID + '/updates/os', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ action: action, force: !!force })
          }).then(async r => ({ code: r.status, d: await r.json() })).then(({ code, d }) => {
            if (code === 409 && d.needs_force) {
              btns.forEach(b => b.disabled = false);
              showConfirmModal(
                d.error + '\n\n' + (ACTIONS[action] || {}).warn + '\n\nВыполнить принудительно?',
                'Активный сервер пула!', 'Выполнить'
              ).then(ok => { if (ok) runAction(action, true); });
              return;
            }
            if (!d.success) {
              btns.forEach(b => b.disabled = false);
              if (window.showToast) showToast(d.error || 'Ошибка', 'error');
              return;
            }
            msg.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-1"></i>' + (d.message || 'Запущено…');
            startPoll();
          }).catch(e => {
            btns.forEach(b => b.disabled = false);
            if (window.showToast) showToast('Ошибка: ' + e, 'error');
          });
        }

        refreshBtn.addEventListener('click', () => load(true));
        document.querySelectorAll('.js-upd-act').forEach(btn => {
          btn.addEventListener('click', () => {
            const action = btn.getAttribute('data-action');
            const a = ACTIONS[action] || { title: 'Выполнить?', warn: '' };
            showConfirmModal(a.warn, a.title, 'Выполнить').then(ok => { if (ok) runAction(action, false); });
          });
        });
        load(false);
      })();
      </script>

      <div class="mt-4 flex items-center gap-2">
        <button type="button" id="uninstallAllBtn" class="px-3 py-1 bg-gray-600 text-white rounded text-sm">Удалить все протоколы</button>
        <form method="POST" action="/servers/{{ server.id }}/delete" class="inline" id="deleteServerForm">
          <button type="button" class="px-3 py-1 bg-red-600 text-white rounded text-sm"
            onclick="showConfirmModal('Контейнер будет остановлен. Это действие необратимо.', 'Удалить сервер {{ server.name }}?', 'Удалить').then(function(ok){ if(ok) document.getElementById('deleteServerForm').submit(); })">
            <i class="fas fa-trash mr-1"></i>Удалить сервер
          </button>
        </form>
        <span id="uninstallMsg" class="ml-3 text-sm text-gray-600"></span>
      </div>

      {% if available_protocols %}
      <div class="mt-4">
        <label class="block text-sm text-gray-600 mb-1">Добавить протокол</label>
        <div class="flex items-center gap-2">
          <select id="availableProtocolSelect" class="px-3 py-2 border rounded">
            {% for p in available_protocols %}
              <option value="{{ p.id }}">{{ p.name }}</option>
            {% endfor %}
          </select>
          <button id="activateProtocolBtn" class="px-3 py-1 bg-green-600 text-white rounded text-sm">Установить</button>
          <span id="activateMsg" class="ml-3 text-sm text-gray-600"></span>
        </div>
      </div>
      {% endif %}

      <!-- Установка протоколов выполняется только через Настройки -->

      <div class="mt-4">
        <label class="block text-sm text-gray-600 mb-1">Установленные протоколы</label>
        <div class="space-y-2">
          {% for sp in server_protocols %}
            <div class="border rounded px-3 py-2">
              <div class="flex items-center justify-between">
                <div class="text-sm font-medium">{{ sp.name }} <span class="text-gray-500">({{ sp.slug }})</span></div>
                <button type="button" class="px-3 py-1 bg-red-600 text-white rounded text-sm btn-uninstall-sp" data-slug="{{ sp.slug }}">Удалить</button>
              </div>
              <div class="mt-1 text-xs text-gray-600">
                {% if sp.server_host %}<span>Host: {{ sp.server_host }}</span>{% endif %}
                {% if sp.server_port %}<span class="ml-2">Port: {{ sp.server_port }}</span>{% endif %}
              </div>
              {% if sp.slug == 'cf-warp' %}
              {# ── WARP Status Widget ── #}
              <div id="warpStatusWidget" class="mt-3 p-3 rounded-lg" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="#F59E0B"/>
                    </svg>
                    <span class="text-sm font-semibold text-white">Cloudflare WARP</span>
                  </div>
                  <div id="warpStatusBadge">
                    <span class="px-2 py-0.5 rounded text-xs bg-gray-600 text-gray-300">
                      <i class="fas fa-spinner fa-spin mr-1"></i>Загрузка...
                    </span>
                  </div>
                </div>

                <div id="warpDetails" class="space-y-1 text-xs">
                  <div class="flex items-center justify-between text-gray-400">
                    <span>WARP IP</span>
                    <span id="warpExitIp" class="font-mono text-gray-300">—</span>
                  </div>
                  <div class="flex items-center justify-between text-gray-400">
                    <span>Пул профилей</span>
                    <span id="warpPool" class="text-gray-300">—</span>
                  </div>
                  <div class="flex items-center justify-between text-gray-400">
                    <span>Ротаций</span>
                    <span id="warpRotations" class="text-gray-300">—</span>
                  </div>
                  <div class="flex items-center justify-between text-gray-400">
                    <span>Режим</span>
                    <span id="warpMode" class="text-gray-300">—</span>
                  </div>
                  <div class="flex items-center justify-between text-gray-400">
                    <span>Сервис</span>
                    <span id="warpSvc" class="text-gray-300">—</span>
                  </div>
                </div>

                <div class="flex gap-2 mt-3">
                  <button id="warpBtnRotate" onclick="warpAction('rotate')" class="flex-1 px-2 py-1 rounded text-xs font-medium text-white" style="background:#8b5cf6;opacity:0.9" disabled>
                    <i class="fas fa-random mr-1"></i>Ротация
                  </button>
                  <button id="warpBtnReconnect" onclick="warpAction('reconnect')" class="flex-1 px-2 py-1 rounded text-xs font-medium text-white" style="background:#3b82f6;opacity:0.9" disabled>
                    <i class="fas fa-sync-alt mr-1"></i>Reconnect
                  </button>
                  <button id="warpBtnDisconnect" onclick="warpAction('disconnect')" class="flex-1 px-2 py-1 rounded text-xs font-medium text-white" style="background:#ef4444;opacity:0.9" disabled>
                    <i class="fas fa-stop mr-1"></i>Stop
                  </button>
                  <button id="warpBtnConnect" onclick="warpAction('connect')" class="flex-1 px-2 py-1 rounded text-xs font-medium text-white" style="background:#22c55e;opacity:0.9" disabled>
                    <i class="fas fa-play mr-1"></i>Start
                  </button>
                </div>

                <p class="text-[10px] text-gray-500 mt-2 leading-tight">
                  ⚠️ WARP ~50-100 МБ RAM • Цепочка: Клиент → WG → WARP → CF → Интернет
                </p>
              </div>
              {% endif %}
            </div>
          {% else %}
            <div class="text-sm text-gray-500">Нет установленных протоколов</div>
          {% endfor %}
        </div>
        <div id="uninstallSpMsg" class="mt-2 text-sm text-gray-600"></div>
      </div>

      {% if server.status == 'active' %}
      <div class="metric-mini" id="serverMetrics">
        <div class="metric-row">
          <i class="fas fa-microchip metric-icon" style="color:#dc3545"></i>
          <span class="metric-label">CPU</span>
          <canvas id="cpuSparkline" class="metric-chart"></canvas>
          <div class="metric-value" id="cpuValue">--</div>
        </div>
        <div class="metric-row">
          <i class="fas fa-memory metric-icon" style="color:#ffc107"></i>
          <span class="metric-label">RAM</span>
          <canvas id="ramSparkline" class="metric-chart"></canvas>
          <div class="metric-value" id="ramValue">--</div>
        </div>
        <div class="metric-row">
          <i class="fas fa-hdd metric-icon" style="color:#17a2b8"></i>
          <span class="metric-label">Disk</span>
          <canvas id="diskSparkline" class="metric-chart"></canvas>
          <div class="metric-value" id="diskValue">--</div>
        </div>
        <div class="metric-row">
          <i class="fas fa-network-wired metric-icon" style="color:#28a745"></i>
          <span class="metric-label">Network</span>
          <canvas id="networkSparkline" class="metric-chart"></canvas>
          <div class="metric-value" id="networkValue">--</div>
        </div>
      </div>
      {% endif %}
    </div>
    <div class="bg-white rounded shadow p-6">
      <h3 class="font-bold mb-4">{{ t('clients.create') }}</h3>
      <form method="POST" action="/servers/{{ server.id }}/clients/create" class="space-y-3" id="createClientForm">
        <div>
          <input name="name" placeholder="{{ t('clients.name') }}" required class="w-full px-3 py-2 border rounded" id="clientName">
        </div>
        <div>
          <input name="login" placeholder="Логин (уникально на сервере, пусто — из имени)" class="w-full px-3 py-2 border rounded" id="clientLogin">
        </div>
        <div>
          <label class="block text-sm text-gray-600 mb-1">{{ t('clients.expiration') }}</label>
          <select name="expires_in_days" class="w-full px-3 py-2 border rounded mb-2" id="expirationSelect" onchange="toggleExpirationInput()">
            <option value="" selected>{{ t('clients.never_expires') }}</option>
            <option value="7">7 {{ t('common.days') }}</option>
            <option value="30">30 {{ t('common.days') }}</option>
            <option value="60">60 {{ t('common.days') }}</option>
            <option value="90">90 {{ t('common.days') }}</option>
            <option value="180">180 {{ t('common.days') }}</option>
            <option value="365">365 {{ t('common.days') }}</option>
            <option value="custom">{{ t('clients.custom_seconds') }}</option>
          </select>
          <input type="number" name="expires_in_seconds" id="expirationSeconds" class="w-full px-3 py-2 border rounded" placeholder="{{ t('clients.enter_seconds') }}" style="display:none;" min="1">
        </div>
        <div>
          <label class="block text-sm text-gray-600 mb-1">{{ t('clients.traffic_limit') }}</label>
          <select name="traffic_limit_gb" class="w-full px-3 py-2 border rounded mb-2" id="trafficSelect" onchange="toggleTrafficInput()">
            <option value="" selected>{{ t('clients.unlimited') }}</option>
            <option value="1">1 GB</option>
            <option value="5">5 GB</option>
            <option value="10">10 GB</option>
            <option value="25">25 GB</option>
            <option value="50">50 GB</option>
            <option value="100">100 GB</option>
            <option value="250">250 GB</option>
            <option value="500">500 GB</option>
            <option value="1000">1000 GB (1 TB)</option>
            <option value="custom">{{ t('clients.custom_mb') }}</option>
          </select>
          <input type="number" name="traffic_limit_mb" id="trafficMegabytes" class="w-full px-3 py-2 border rounded" placeholder="{{ t('clients.enter_megabytes') }}" style="display:none;" min="1">
        </div>
        <button type="submit" class="gradient-bg text-white px-4 py-2 rounded w-full" id="createClientBtn">
          <span id="createClientText">{{ t('form.create') }}</span>
          <i class="fas fa-spinner fa-spin" id="createClientSpinner" style="display:none;"></i>
        </button>
      </form>
    </div>
  </div>

  <div class="bg-white rounded shadow">
    <div class="px-6 py-4 border-b flex justify-between items-center">
      <h3 class="font-bold">{{ t('clients.title') }} ({{ clients|length }})</h3>
      {% if clients|length > 0 %}
      <div class="relative">
        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
        <input id="clientSearch" type="text" oninput="filterClients()" placeholder="Поиск по имени или IP"
               class="pl-9 pr-3 py-2 border rounded text-sm w-56">
      </div>
      {% endif %}
    </div>
    {% if clients|length > 0 %}
    <div class="w-full overflow-x-auto">
    <table class="w-full" style="min-width: 760px;">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.name') }}</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.status') }}</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.expiration') }}</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.traffic') }}</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('common.speed') }}</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.last_handshake') }}</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">{{ t('clients.actions') }}</th>
        </tr>
      </thead>
      <tbody id="clientsTableBody">
        {% for client in clients %}
        {# online_logins is authoritative: it is computed from traffic received from
           the client, so a disconnected client drops out at once instead of
           lingering until its handshake ages. #}
        {% set is_online = client.name in online_logins %}
        <tr class="border-t client-row" data-search="{{ (client.name ~ ' ' ~ client.client_ip)|lower }}" data-public-key="{{ client.public_key }}">
          <td class="px-4 py-3">
            <div class="font-medium text-gray-900">{{ client.name }}</div>
            <div class="text-xs text-gray-400 font-mono">{{ client.client_ip }}</div>
          </td>
          <td class="px-4 py-3" data-status-cell data-client-name="{{ client.name }}" data-client-status="{{ client.status }}" data-last-handshake="{{ client.last_handshake }}">
            {% if is_online %}
              <span class="online-badge inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 rounded text-xs"><i class="fas fa-wifi"></i>Online</span>
            {% elseif client.status == 'active' %}
              <span class="status-badge inline-flex items-center gap-1 px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs"><i class="fas fa-circle text-[7px]"></i>{{ t('status.active') }}</span>
            {% else %}
              <span class="status-badge inline-flex items-center gap-1 px-2 py-1 bg-red-100 text-red-800 rounded text-xs"><i class="fas fa-ban"></i>{{ t('status.disabled') }}</span>
            {% endif %}
          </td>
          <td class="px-4 py-3 text-sm">
            {% if client.expires_at %}
              {% set diff_days = ((client.expires_at|date('U') - "now"|date('U')) / 86400)|round %}
              {% if diff_days < 0 %}
                <span class="inline-flex items-center gap-1 px-2 py-1 bg-red-100 text-red-800 rounded text-xs"><i class="fas fa-exclamation-circle"></i>{{ t('clients.expired') }}</span>
              {% elseif diff_days <= 7 %}
                <span class="inline-flex items-center gap-1 px-2 py-1 bg-yellow-100 text-yellow-800 rounded text-xs"><i class="fas fa-clock"></i>{{ diff_days }} {{ t('common.days') }}</span>
              {% else %}
                <span class="text-gray-600">{{ client.expires_at|date('Y-m-d') }}</span>
              {% endif %}
            {% else %}
              <span class="text-green-500 text-lg" title="{{ t('clients.never_expires') }}">&infin;</span>
            {% endif %}
          </td>
          <td class="px-4 py-3 text-xs">
            <div class="text-gray-600 font-mono whitespace-nowrap">&uarr;{{ client.bytes_sent|default(0)|bytes_format }} &darr;{{ client.bytes_received|default(0)|bytes_format }}</div>
            {% if client.traffic_limit %}
              {% set total_traffic = (client.bytes_sent|default(0) + client.bytes_received|default(0)) %}
              {% set percentage = ((total_traffic / client.traffic_limit) * 100)|round %}
              {% set bar_color = percentage >= 100 ? 'bg-red-500' : (percentage >= 80 ? 'bg-yellow-500' : 'bg-green-500') %}
              <div class="mt-1" style="width: 7rem; max-width: 7rem;">
                <div class="h-1.5 bg-gray-200 rounded-full overflow-hidden">
                  <div class="{{ bar_color }} h-1.5" style="width: {{ percentage > 100 ? 100 : percentage }}%"></div>
                </div>
                <div class="text-[10px] text-gray-400 mt-0.5 whitespace-nowrap">{{ total_traffic|bytes_format }} / {{ client.traffic_limit|bytes_format }}{% if percentage >= 80 %} &middot; {{ percentage }}%{% endif %}</div>
              </div>
            {% else %}
              <div class="text-[10px] text-gray-400 mt-0.5">{{ t('clients.unlimited') }}</div>
            {% endif %}
          </td>
          <td class="px-4 py-3 text-xs">
            <div id="client-speed-{{ client.id }}" class="font-mono leading-tight whitespace-nowrap">
              <div class="text-green-600">&uarr;{{ ((client.speed_up|default(0) * 8) / 1000000)|number_format(2) }} Mbit</div>
              <div class="text-blue-600">&darr;{{ ((client.speed_down|default(0) * 8) / 1000000)|number_format(2) }} Mbit</div>
            </div>
          </td>
          <td class="px-4 py-3 text-xs whitespace-nowrap" data-hs-cell>
            {% if client.last_handshake %}
              <span class="text-gray-600 block">{{ client.last_handshake|split(' ')|first }}</span>
              <span class="text-gray-400 block">{{ client.last_handshake|split(' ')|last }}</span>
            {% else %}
              <span class="text-gray-400">{{ t('clients.never') }}</span>
            {% endif %}
          </td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <a href="/clients/{{ client.id }}" class="text-purple-600 hover:text-purple-800 px-1.5" title="{{ t('servers.view') }}" aria-label="{{ t('servers.view') }}"><i class="fas fa-eye"></i></a>
            <button type="button" class="text-blue-600 hover:text-blue-800 px-1.5" onclick="diagnoseClient({{ client.id }})" title="Диагностика" aria-label="Диагностика"><i class="fas fa-stethoscope"></i></button>
            {% if client.status == 'active' %}
              <form method="POST" action="/clients/{{ client.id }}/revoke" style="display:inline;">
                <button type="button" class="text-orange-600 hover:text-orange-800 px-1.5" onclick="confirmAction(this, '{{ t('clients.revoke_confirm') }}')" title="{{ t('clients.revoke') }}" aria-label="{{ t('clients.revoke') }}"><i class="fas fa-user-slash"></i></button>
              </form>
            {% else %}
              <form method="POST" action="/clients/{{ client.id }}/restore" style="display:inline;">
                <button type="submit" class="text-green-600 hover:text-green-800 px-1.5" title="{{ t('clients.restore') }}" aria-label="{{ t('clients.restore') }}"><i class="fas fa-user-check"></i></button>
              </form>
            {% endif %}
            <form method="POST" action="/clients/{{ client.id }}/delete" style="display:inline;">
              <button type="button" class="text-red-600 hover:text-red-800 px-1.5" onclick="confirmAction(this, '{{ t('clients.delete_confirm') }}')" title="{{ t('clients.delete') }}" aria-label="{{ t('clients.delete') }}"><i class="fas fa-trash"></i></button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    <div id="clientsNoResults" class="p-6 text-center text-gray-400 hidden">Ничего не найдено</div>
    {% else %}
    <div class="p-12 text-center text-gray-500">{{ t('clients.no_clients') }}</div>
    {% endif %}
  </div>
</div>

<script>
async function confirmAction(btn, message) {
  if (await showConfirmModal(message)) {
    btn.closest('form').submit();
  }
}

function toggleExpirationInput() {
  const select = document.getElementById('expirationSelect');
  const input = document.getElementById('expirationSeconds');
  if (select.value === 'custom') {
    input.style.display = 'block';
    input.required = true;
    input.focus();
  } else {
    input.style.display = 'none';
    input.required = false;
    input.value = '';
  }
}

document.addEventListener('DOMContentLoaded', function() {
  const uninstallAllBtn = document.getElementById('uninstallAllBtn');
  const msg = document.getElementById('uninstallMsg');

  if (uninstallAllBtn) {
    uninstallAllBtn.addEventListener('click', async function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (!(await showConfirmModal('Все Amnezia-контейнеры на сервере будут удалены.', 'Удалить все протоколы?', 'Удалить'))) return;

      const origHTML = uninstallAllBtn.innerHTML;
      uninstallAllBtn.disabled = true;
      uninstallAllBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-1"></i>Удаление...';
      uninstallAllBtn.className = uninstallAllBtn.className.replace('bg-gray-600', 'bg-yellow-600');
      uninstallAllBtn.style.cursor = 'wait';
      msg.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#fef3c7;border:1px solid #f59e0b;border-radius:6px;margin-top:4px;">' +
        '<i class="fas fa-circle-notch fa-spin text-yellow-600"></i>' +
        '<span style="color:#92400e;font-weight:500;">Удаление всех протоколов... Это может занять минуту</span></div>';

      try {
        const res = await fetch(`/servers/{{ server.id }}/protocols/uninstall-all`, { method: 'POST', credentials: 'same-origin' });
        const data = await res.json();
        if (data.success) {
          uninstallAllBtn.innerHTML = '<i class="fas fa-check mr-1"></i>Удалено';
          uninstallAllBtn.className = uninstallAllBtn.className.replace('bg-yellow-600', 'bg-green-600');
          msg.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#d1fae5;border:1px solid #10b981;border-radius:6px;margin-top:4px;">' +
            '<i class="fas fa-check-circle text-green-600"></i>' +
            '<span style="color:#065f46;font-weight:500;">' + (data.message || 'Все протоколы удалены') + '</span></div>';
          setTimeout(() => location.reload(), 1200);
        } else {
          uninstallAllBtn.innerHTML = origHTML;
          uninstallAllBtn.className = uninstallAllBtn.className.replace('bg-yellow-600', 'bg-gray-600');
          msg.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#fee2e2;border:1px solid #ef4444;border-radius:6px;margin-top:4px;">' +
            '<i class="fas fa-exclamation-circle text-red-600"></i>' +
            '<span style="color:#991b1b;">' + (data.error || 'Ошибка') + '</span></div>';
        }
      } catch (e) {
        uninstallAllBtn.innerHTML = origHTML;
        uninstallAllBtn.className = uninstallAllBtn.className.replace('bg-yellow-600', 'bg-gray-600');
        msg.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#fee2e2;border:1px solid #ef4444;border-radius:6px;margin-top:4px;">' +
          '<i class="fas fa-exclamation-circle text-red-600"></i>' +
          '<span style="color:#991b1b;">' + (e.message || 'Ошибка связи') + '</span></div>';
      }
      uninstallAllBtn.disabled = false;
    });
  }

  const activateBtn = document.getElementById('activateProtocolBtn');
  if (activateBtn) {
    activateBtn.addEventListener('click', async function() {
      const select = document.getElementById('availableProtocolSelect');
      const msg2 = document.getElementById('activateMsg');
      msg2.textContent = '';
      const pid = select ? select.value : '';
      if (!pid) { msg2.textContent = 'Нет доступных протоколов'; return; }
      activateBtn.disabled = true;
      msg2.innerHTML = '<i class="fas fa-circle-notch fa-spin text-blue-600 mr-2"></i><span class="text-gray-700">Установка протокола...</span>';
      try {
        const res = await fetch('/servers/{{ server.id }}/protocols/activate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'protocol_id=' + encodeURIComponent(pid)
        });
        let data;
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) { data = await res.json(); } else { data = { error: await res.text() }; }
        if (res.ok && data && data.success !== false && !data.error) {
          msg2.textContent = 'Готово';
          setTimeout(() => location.reload(), 1000);
        } else {
          msg2.textContent = (data && data.error) ? data.error : ('Ошибка установки (' + res.status + ')');
        }
      } catch (e) {
        msg2.textContent = e.message || 'Ошибка связи';
      }
      activateBtn.disabled = false;
    });
  }

  document.querySelectorAll('.btn-uninstall-sp').forEach(btn => {
    btn.addEventListener('click', async function(e) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      const confirmed = await showConfirmModal('Удалить протокол и всех его клиентов?', 'Удаление протокола');
      if (!confirmed) return;
      const slug = btn.getAttribute('data-slug');
      const m = document.getElementById('uninstallSpMsg');
      const card = btn.closest('.border.rounded');

      // Save original button state
      const origHTML = btn.innerHTML;
      const origClasses = btn.className;

      // Disable ALL uninstall buttons
      document.querySelectorAll('.btn-uninstall-sp').forEach(b => { b.disabled = true; b.style.opacity = '0.5'; });

      // Animate the clicked button
      btn.style.opacity = '1';
      btn.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-1"></i>Удаление...';
      btn.className = btn.className.replace('bg-red-600', 'bg-yellow-600');
      btn.style.cursor = 'wait';
      btn.style.minWidth = btn.offsetWidth + 'px';

      // Add overlay to protocol card
      if (card) {
        card.style.position = 'relative';
        const overlay = document.createElement('div');
        overlay.id = 'uninstall-overlay-' + slug;
        overlay.style.cssText = 'position:absolute;inset:0;background:rgba(239,68,68,0.05);border-radius:inherit;pointer-events:none;z-index:5;';
        card.appendChild(overlay);
        card.style.transition = 'opacity 0.3s';
        card.style.opacity = '0.7';
      }

      // Show progress message
      m.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#fef3c7;border:1px solid #f59e0b;border-radius:6px;margin-top:8px;">' +
        '<i class="fas fa-circle-notch fa-spin text-yellow-600"></i>' +
        '<span style="color:#92400e;font-weight:500;">Удаление <b>' + slug + '</b>... Это может занять до 30 секунд</span></div>';

      try {
        const resp = await fetch('/servers/{{ server.id }}/protocols/' + encodeURIComponent(slug) + '/uninstall', { method: 'POST', credentials: 'same-origin' });
        let data;
        const ct = resp.headers.get('content-type') || '';
        if (ct.includes('application/json')) { data = await resp.json(); } else { data = { error: await resp.text() }; }
        if (resp.ok && data && !data.error) {
          // Success state
          btn.innerHTML = '<i class="fas fa-check mr-1"></i>Удалено';
          btn.className = btn.className.replace('bg-yellow-600', 'bg-green-600');
          if (card) { card.style.opacity = '0.4'; }
          m.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#d1fae5;border:1px solid #10b981;border-radius:6px;margin-top:8px;">' +
            '<i class="fas fa-check-circle text-green-600"></i>' +
            '<span style="color:#065f46;font-weight:500;">Протокол удалён. Клиенты: ' + (data.clients_removed || 0) + '</span></div>';
          setTimeout(() => location.reload(), 1200);
        } else {
          // Error state
          btn.innerHTML = '<i class="fas fa-times mr-1"></i>Ошибка';
          btn.className = origClasses;
          if (card) { card.style.opacity = '1'; const ov = document.getElementById('uninstall-overlay-' + slug); if (ov) ov.remove(); }
          m.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#fee2e2;border:1px solid #ef4444;border-radius:6px;margin-top:8px;">' +
            '<i class="fas fa-exclamation-circle text-red-600"></i>' +
            '<span style="color:#991b1b;">' + ((data && data.error) ? data.error : ('Ошибка (' + resp.status + ')')) + '</span></div>';
          setTimeout(() => { btn.innerHTML = origHTML; document.querySelectorAll('.btn-uninstall-sp').forEach(b => { b.disabled = false; b.style.opacity = '1'; }); }, 3000);
        }
      } catch (err) {
        btn.innerHTML = '<i class="fas fa-times mr-1"></i>Ошибка';
        btn.className = origClasses;
        if (card) { card.style.opacity = '1'; const ov = document.getElementById('uninstall-overlay-' + slug); if (ov) ov.remove(); }
        m.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#fee2e2;border:1px solid #ef4444;border-radius:6px;margin-top:8px;">' +
          '<i class="fas fa-exclamation-circle text-red-600"></i>' +
          '<span style="color:#991b1b;">' + (err.message || 'Ошибка связи') + '</span></div>';
        setTimeout(() => { btn.innerHTML = origHTML; document.querySelectorAll('.btn-uninstall-sp').forEach(b => { b.disabled = false; b.style.opacity = '1'; }); }, 3000);
      }
    });
  });


});

