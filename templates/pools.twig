{% extends "layout.twig" %}
{% block title %}Пулы{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold">Здоровье пулов</h1>
    <p class="text-gray-600">Активный/резерв, DNS, готовность к failover — по всем пулам одним экраном</p>
  </div>

  {% for p in pools %}
  {% set pool = p.pool %}
  <div class="bg-white shadow rounded-lg mb-6 overflow-hidden">
    <div class="px-5 py-4 border-b bg-gray-50 flex items-center justify-between flex-wrap gap-2">
      <div>
        <h2 class="text-xl font-semibold">{{ pool.name }}</h2>
        <div class="text-sm text-gray-500">
          домен <span class="font-mono">{{ pool.domain ?: '—' }}</span>
          · порт {{ pool.vpn_port }} · подсеть <span class="font-mono">{{ pool.vpn_subnet }}</span>
        </div>
      </div>
      <div class="text-sm text-right">
        {% if p.provider_configured %}
          <span class="px-2 py-0.5 rounded bg-green-100 text-green-800">DNS-провайдер настроен</span>
        {% else %}
          <span class="px-2 py-0.5 rounded bg-yellow-100 text-yellow-800">DNS-провайдер не настроен</span>
        {% endif %}
        <div class="text-gray-500 mt-1">DNS указывает на: <span class="font-mono">{{ p.resolved_ips|join(', ') ?: '—' }}</span></div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-gray-600">
          <tr>
            <th class="px-4 py-2 text-left font-medium">Сервер</th>
            <th class="px-4 py-2 text-left font-medium">Роль</th>
            <th class="px-4 py-2 text-left font-medium">DNS→сюда</th>
            <th class="px-4 py-2 text-left font-medium">Чистый</th>
            <th class="px-4 py-2 text-left font-medium">Синхрон</th>
            <th class="px-4 py-2 text-left font-medium">Статус</th>
            <th class="px-4 py-2 text-left font-medium">Репутация IP</th>
            <th class="px-4 py-2 text-left font-medium">Готов к failover</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {% for m in p.members %}
          {% set ready = m.status == 'active' and not m.sync_pending and m.validated_clean == 1 %}
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2">
              <div class="font-medium">{{ m.name }}</div>
              <div class="text-xs text-gray-500 font-mono">{{ m.host }} · #{{ m.id }} · prio {{ m.priority }}</div>
            </td>
            <td class="px-4 py-2">
              {% if m.role == 'active' %}
                <span class="px-2 py-0.5 rounded bg-purple-100 text-purple-800 font-medium">active</span>
              {% else %}
                <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-700">standby</span>
              {% endif %}
            </td>
            <td class="px-4 py-2">{{ m.dns_points_here ? '✓' : '—' }}</td>
            <td class="px-4 py-2">
              {% if m.validated_clean == 1 %}<span class="text-green-700">✓ чистый</span>
              {% elseif m.validated_clean is null %}<span class="text-gray-400">— не проверен</span>
              {% else %}<span class="text-red-700">✗ не чистый</span>{% endif %}
              {% if m.validation_note %}<div class="text-xs text-gray-400">{{ m.validation_note }}</div>{% endif %}
            </td>
            <td class="px-4 py-2">
              {% if m.sync_pending %}<span class="text-red-700">ожидает</span>{% else %}<span class="text-green-700">ок</span>{% endif %}
            </td>
            <td class="px-4 py-2">{{ m.status }}</td>
            <td class="px-4 py-2">
              {% set rep = reputation[m.id] %}
              {% if rep is null %}
                <span class="text-gray-400">— не проверялось</span>
              {% else %}
                {% set listed = rep.listed_on %}
                {% set score = rep.abuse_score %}
                {% if listed|length > 0 or (score is not null and score >= 50) %}
                  <span class="px-2 py-0.5 rounded bg-red-100 text-red-800" title="{{ listed|join(', ') }}">
                    в блок-листах{% if score is not null %} ({{ score }}){% endif %}
                  </span>
                {% else %}
                  <span class="px-2 py-0.5 rounded bg-green-100 text-green-800">чист</span>
                {% endif %}
                <div class="text-xs text-gray-400">{{ rep.checked_at }}</div>
              {% endif %}
            </td>
            <td class="px-4 py-2">
              {% if m.role == 'active' %}
                <span class="text-gray-400">— (активный)</span>
              {% elseif ready %}
                <span class="px-2 py-0.5 rounded bg-green-100 text-green-800">готов</span>
              {% else %}
                <span class="px-2 py-0.5 rounded bg-red-100 text-red-800">не готов</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% else %}
  <div class="bg-white shadow rounded-lg p-8 text-center text-gray-400">Пулов пока нет</div>
  {% endfor %}
</div>
{% endblock %}
